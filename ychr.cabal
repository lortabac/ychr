cabal-version:      3.4
name:               ychr
version:            0.1.0.0
synopsis:           A Constraint Handling Rules compiler with multiple backends
description:
    Constraint Handling Rules (CHR) is a declarative, rule-based language for
    writing constraint solvers, type inferencers, and other rule-driven logic.
    A program is a set of rules that rewrite a multiset of constraints until no
    rule applies.

    YCHR compiles standard CHR — Prolog-compatible syntax, extended with
    Erlang-style user-defined functions and an optional gradual type system —
    to a small abstract VM, which is either interpreted directly in Haskell or
    translated to Scheme.

    == Using YCHR as a Haskell library

    The common compile-and-query path is available from a single import:

    > {-# LANGUAGE OverloadedStrings #-}
    > import Resources (stdlib) -- the embedded resources, see below
    > import YCHR
    >
    > main :: IO ()
    > main = do
    >   result <- compileFiles stdlib True ["Order.chr"]
    >   case result of
    >     Left err -> putStr (displayError err)
    >     Right (cp, _warnings) -> do
    >       r <- runQueryCompiled cp goal "R"
    >       print (r :: Either ConvertError Int)
    >   where goal = CompoundTerm (Unqualified "compute") [VarTerm "R"]

    @stdlib@ comes from the embedding layer: it is the parsed standard
    library, an explicit input because the library embeds nothing at
    compile time. A build that needs the bundled libraries supplies
    their sources — a Template Haskell splice of @libraries\/*.chr@, or
    a directory read at run time; the embedding guide shows a minimal
    @Resources@ module. Compile and run a CHR program once, then feed it
    Haskell values and decode its answers back through the @ToTerm@ \/
    @FromTerm@ bridge. A program can also be built in Haskell directly
    with the @YCHR.DSL@ combinators instead of parsed from source, and
    Haskell functions can be exposed to CHR programs as host calls.

    For a worked example — a lambda-calculus type inferencer written in CHR
    and driven from Haskell, including the resources it needs — see the
    embedding guide:
    <https://github.com/lortabac/ychr/blob/master/docs/how-to/embed-a-chr-module.md>.

    == Status

    Early release. The Haskell interpreter and the Scheme backend work; the
    JavaScript backend and most of the optimization catalogue are not yet
    implemented. The @ychr@ command-line compiler and REPL ship with this
    package. Compiling to Scheme additionally requires the runtime from a
    source checkout. Full status in the roadmap:
    <https://github.com/lortabac/ychr/blob/master/docs/roadmap.md>.

    Modules under @YCHR.Internal@ are implementation details, exposed for
    documentation purposes only, and are not covered by the package version
    policy.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Lorenzo Tabacchini
maintainer:         lortabac@gmx.com
copyright:          (c) 2026 Lorenzo Tabacchini
homepage:           https://github.com/lortabac/ychr
bug-reports:        https://github.com/lortabac/ychr/issues
category:           Language
build-type:         Simple
-- Only versions actually exercised are listed here. 9.6.6 and 9.12.2 have
-- been built and had the test suite run against them locally; 9.8.4,
-- 9.10.1 and 9.14.1 are built (compile-only) by the CI matrix.
tested-with:        GHC == 9.6.6, GHC == 9.8.4, GHC == 9.10.1,
                    GHC == 9.12.2, GHC == 9.14.1

extra-doc-files:      README.md
                    , CHANGELOG.md

-- 'examples/stlc/*.hs' is listed explicitly: those modules belong to the
-- 'stlc-typechecker' component, which is unbuildable unless '-fexamples' is
-- set, and cabal does not collect the sources of an unbuildable component.
-- Without this the tarball would only carry them when the release happened
-- to be cut with the flag on.
extra-source-files:   libraries/*.chr
                    , typechecker/*.chr
                    -- The generated resource modules themselves are
                    -- produced by `make resources` and are not
                    -- committed. This file is here so the directory
                    -- exists in the checkout and in the sdist, which
                    -- Cabal requires for the `hs-source-dirs` entry
                    -- that names it (see `executable ychr` below).
                    , generated/README.md
                    , examples/*.chr
                    , examples/stlc/*.chr
                    , examples/stlc/*.hs
                    , bench/scheme/*.chr
                    , bench/scheme/*.scm
                    , bench/scheme/bench/*.sls
                    -- The playground's page and its MicroHs-only bridge.
                    -- Neither is a component source — the bridge is
                    -- compiled by `mhs` directly, from the Makefile —
                    -- so without these the sdist could not run
                    -- `make playground-wasm`.
                    , playground/*.html
                    , playground/*.css
                    , playground/*.js
                    , playground/test/smoke.cjs
                    , playground/YCHR/Playground/Wasm.hs
                    , test/golden/**/*.chr
                    , test/golden/**/*.goal
                    , test/golden/**/*.expected
                    , test/golden/**/*.error
                    , test/golden/**/*.md

source-repository head
    type:     git
    location: https://github.com/lortabac/ychr.git

-- The @stlc-typechecker@ example driver and the playground harness are
-- not built by default, so that @cabal install ychr@ does not put them on
-- a user's PATH. @ychr-codegen@ is *not* gated: it is the documented way
-- to regenerate the resources @exe:ychr@ needs under MicroHs, so an
-- sdist consumer has to be able to build and run it.
flag examples
    description: Build the example executables.
    default:     False
    manual:      True

common warnings
    ghc-options: -Wall
    default-extensions:
        DuplicateRecordFields
        NoFieldSelectors
        OverloadedRecordDot

common deps
    build-depends:    base >=4.18 && <4.23
                    , array >=0.5 && <0.6
                    , containers >=0.6 && <0.9
                    , filepath >=1.4 && <1.6
                    , text >=2.0 && <2.2

-- Components that compile the @embed/@ splices must tell Cabal they use
-- Template Haskell, even though each spliced module already carries the
-- @LANGUAGE TemplateHaskell@ pragma. Cabal never reads source pragmas, and
-- 'other-extensions' is the field that informs it without also enabling the
-- extension in every module. Cabal uses that information to build the
-- component's dynamic way as well, which a profiled build needs because
-- GHC's splice interpreter cannot load the profiled @.p_o@ objects; without
-- it the build dies with
-- @cannot find object file ... .dyn_o while linking an interpreted
-- expression@ (haskell/cabal#5961). Unlike 'default-extensions' the
-- declaration is not passed to GHC, so 'TemplateHaskell' stays scoped to
-- the modules that opt into it.
common th-embed
    if impl(ghc)
        other-extensions: TemplateHaskell

executable ychr
    import:           warnings, deps, th-embed
    main-is:          Main.hs
    -- 'YCHR.Embedded' is this component's resources provider. It has one
    -- implementation per compiler, switched by 'hs-source-dirs':
    --
    --  * GHC compiles 'embed/YCHR/Embedded.hs', which splices
    --    libraries/*.chr and typechecker/*.chr into the binary with
    --    Template Haskell (self-contained, no run-time lookup);
    --  * MicroHs has no Template Haskell (dev-docs/MICROHS_GAPS.md,
    --    gap 5) and cannot afford to re-decode the resources in every
    --    process, so it compiles 'src/mhs/YCHR/Embedded.hs': the same
    --    'loadResources' entry point, backed by the modules under
    --    'generated/' that `make resources` writes
    --    (dev-docs/MICROHS_PERFORMANCE.md, option B).
    --
    -- 'app/Main.hs' imports only 'loadResources', so it is one source
    -- file for both compilers.
    other-modules:    YCHR.Embedded
    build-depends:    ychr
                    , directory >=1.3 && <1.4
                    , optparse-applicative >=0.17 && <0.20
    hs-source-dirs:   app
    if impl(ghc)
        hs-source-dirs:   embed
        other-modules:    YCHR.Embedded.StdLib
                        , YCHR.Embedded.TypeCheck
        build-depends:    template-haskell >=2.20 && <2.25
    if impl(mhs)
        hs-source-dirs:   src/mhs
                        , generated
        other-modules:    YCHR.Embedded.Generated.StdLib
                        , YCHR.Embedded.Generated.TypeCheck
        -- Both modules are written by `make resources` before
        -- `mcabal build` runs. Listing them in 'autogen-modules' is
        -- what lets `cabal check` and `cabal sdist` pass on a checkout
        -- where they have not been generated yet: without it Cabal
        -- reports the module missing and refuses to pack the sdist.
        autogen-modules:  YCHR.Embedded.Generated.StdLib
                        , YCHR.Embedded.Generated.TypeCheck
    default-language: GHC2021

-- The build step behind solution B of dev-docs/MICROHS_PERFORMANCE.md:
-- it decodes libraries/*.chr and typechecker/*.chr once and writes them
-- as literal Haskell modules under generated/ (see `executable ychr`
-- above). Run through `make resources`; `--check` re-emits in memory and
-- diffs against the files on disk.
--
-- GHC-only: it uses GHC.Generics to walk the AST, and its output — not
-- the generator — is what MicroHs compiles. The emitter modules live in
-- 'embed/' so that 'test:ychr-tests' can exercise them too.
executable ychr-codegen
    import:           warnings, deps
    main-is:          Main.hs
    hs-source-dirs:   codegen
                    , embed
    other-modules:    YCHR.Embedded.Generate.Code
                    , YCHR.Embedded.Generate.ToCode
                    , YCHR.Embedded.Generate.Instances
                    , YCHR.Embedded.Generate.Emit
    build-depends:    ychr
                    , directory >=1.3 && <1.4
    if impl(mhs)
        buildable:    False
    default-language: GHC2021

-- End-to-end example: a Haskell program that embeds a CHR module.
-- @examples/stlc/stlc.chr@ is a lambda-calculus type inferencer written in
-- CHR; this driver embeds it and drives it through YCHR.Convert.
executable stlc-typechecker
    import:           warnings, deps, th-embed
    main-is:          Main.hs
    if !flag(examples)
        buildable:    False
    other-modules:    Embed
                    , Syntax
                    , Parser
                    , YCHR.Embedded
                    , YCHR.Embedded.StdLib
                    , YCHR.Embedded.TypeCheck
    build-depends:    ychr
                    , directory >=1.3 && <1.4
                    , parsec >=3.1 && <3.2
    hs-source-dirs:   examples/stlc
                    , embed
    if impl(ghc)
        build-depends: template-haskell >=2.20 && <2.25
    default-language: GHC2021

-- The web playground's native harness: the same compile/query/type-check
-- operations the page drives through WASM, over a line protocol on
-- stdin/stdout, so the bridge can be tested without emscripten
-- (@test/playground/@). 'YCHR.Playground' holds the logic and is shared
-- with the WASM entry point ('playground/YCHR/Playground/Wasm.hs'),
-- which is deliberately not listed here: it carries 'foreign export'
-- declarations and only the MicroHs build — @make playground-wasm@, which
-- invokes @mhs@ directly — compiles it.
--
-- Unbuildable unless '-fexamples' is set, like the stlc driver and for
-- the same reason: @cabal install ychr@ should put only the compiler on
-- a user's PATH. Under MicroHs it is never buildable — the WASM build
-- does not go through cabal, and @mcabal build@ must keep building
-- exactly what it built before.
executable ychr-playground
    import:           warnings, deps
    main-is:          Main.hs
    other-modules:    YCHR.Playground
    hs-source-dirs:   playground
    build-depends:    ychr
    if impl(mhs) || !flag(examples)
        buildable:    False
    default-language: GHC2021

test-suite ychr-tests
    import:           warnings, deps, th-embed
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    YCHR.CollectTest
                    , YCHR.CompileTest
                    , YCHR.Backend.SchemeTest
                    , YCHR.ConvertTest
                    , YCHR.ErrorCodeTest
                    , YCHR.RunTest
                    , YCHR.DSLTest
                    , YCHR.DesugarTest
                    , YCHR.Desugar.InlineTest
                    , YCHR.ExhaustivenessTest
                    , YCHR.Embedded.Generate.Code
                    , YCHR.Embedded.Generate.Emit
                    , YCHR.Embedded.Generate.Instances
                    , YCHR.Embedded.Generate.ToCode
                    , YCHR.GenerateTest
                    , YCHR.GoldenTest
                    , YCHR.Interpreter.SlotsTest
                    , YCHR.MetaTest
                    , YCHR.ParserTest
                    , YCHR.PExprRoundtripTest
                    , YCHR.PExprTest
                    , YCHR.PrettyTest
                    , YCHR.RenameTest
                    , YCHR.ResourcesTest
                    , YCHR.RoundtripTest
                    , YCHR.TestHelpers
                    , YCHR.TextShimTest
                    , YCHR.TypeCheckTest
                    , YCHR.TypeSoundnessTest
                    , YCHR.TypeSoundness.Gen
                    , YCHR.TypeSoundness.Instrument
                    , YCHR.TypeSoundness.Observe
                    , YCHR.TypeSoundness.Oracle
                    , YCHR.TypeSoundness.Preamble
                    , YCHR.TypeSoundness.Render
                    , YCHR.TypeSoundness.Types
                    , YCHR.Runtime.VarTest
                    , YCHR.Runtime.StoreTest
                    , YCHR.Runtime.IndexTest
                    , YCHR.Runtime.HistoryTest
                    , YCHR.Runtime.ReactivationTest
                    , YCHR.Runtime.InterpreterTest
                    , YCHR.VM.SExprTest
                    , YCHR.VM.ClosureTest
                    , YCHR.Embedded
                    , YCHR.Embedded.StdLib
                    , YCHR.Embedded.TypeCheck
    hs-source-dirs:   test
                    , embed
    build-depends:    ychr
                    , directory >=1.3 && <1.4
                    , hedgehog >=1.5 && <2
                    , parsec >=3.1 && <3.2
                    , tasty >=1.4 && <1.6
                    , tasty-hedgehog >=1.4 && <2
                    , tasty-hunit >=0.10 && <0.11
    -- Tasty runs the suite's ~1900 independent tests on all cores, so the
    -- Golden group and the two TypeSoundness properties overlap instead of
    -- serializing on one core. The tests are independent and touch no
    -- process-global state (no temp files, no handle redirection, no
    -- chdir); keep it that way. On a machine that already runs another
    -- suite, bound the worker count with `TASTY_NUM_THREADS=N` or
    -- `cabal test --test-options='-jN'`.
    ghc-options:      -threaded
                      -rtsopts
                      "-with-rtsopts=-N"
    if impl(ghc)
        build-depends: template-haskell >=2.20 && <2.25
    default-language: GHC2021

benchmark ychr-bench
    import:           warnings, deps, th-embed
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    YCHR.Embedded
                    , YCHR.Embedded.StdLib
                    , YCHR.Embedded.TypeCheck
    hs-source-dirs:   bench
                    , embed
    build-depends:    ychr
                    , criterion >=1.6 && <1.7
                    , directory >=1.3 && <1.4
    if impl(ghc)
        build-depends: template-haskell >=2.20 && <2.25
    ghc-options:      -O2
    default-language: GHC2021

library
    import:           warnings, deps

    -- Public API — the supported surface for embedding YCHR as a Haskell
    -- library. 'YCHR' is the umbrella entry point (compile + query +
    -- marshalling); 'YCHR.DSL' builds programs in Haskell; 'YCHR.Convert'
    -- is the value bridge (with GHC-only generic derivation in
    -- 'YCHR.Convert.Generic', added under 'if impl(ghc)' below); 'YCHR.Run'
    -- exposes the lower-level session and multi-goal APIs. These are the
    -- modules covered by the package version policy.
    exposed-modules:  YCHR
                    , YCHR.DSL
                    , YCHR.Convert
                    , YCHR.Run
                    , YCHR.Types

    -- Provisional MicroHs shim. "Data.Text.Shim" supplies the "Data.Text"
    -- functions gap 4 lists. Exposed (like the YCHR.Internal modules) so the
    -- CLI and the tests can import it. Delete it with its source file.
    exposed-modules:  Data.Text.Shim

    -- Internal. These are implementation details: they carry no
    -- compatibility guarantee and are not covered by the package version
    -- policy. They stay exposed (rather than hidden) so their Haddocks are
    -- browsable — the compiler's own documentation lives in them — and so
    -- the CLI, tests, and benchmarks in this package can reach them. The
    -- 'Internal' namespace is the contract; import at your own risk.
    exposed-modules:  YCHR.Internal.Backend.Scheme
                    , YCHR.Internal.Backend.SchemeDriver
                    , YCHR.Internal.Collect
                    , YCHR.Internal.Collected
                    , YCHR.Internal.Constructors
                    , YCHR.Internal.Compile
                    , YCHR.Internal.Loc
                    , YCHR.Internal.Compile.Pipeline
                    , YCHR.Internal.Compile.Names
                    , YCHR.Internal.Compile.Occurrences
                    , YCHR.Internal.Compile.Passive
                    , YCHR.Internal.Compile.Types
                    , YCHR.Internal.Diagnostic
                    , YCHR.Internal.Display
                    , YCHR.Internal.Exhaustiveness
                    , YCHR.Internal.Interpreter.Slots
                    , YCHR.Internal.Repl
                    , YCHR.Internal.Meta
                    , YCHR.Internal.Desugared
                    , YCHR.Internal.Desugar
                    , YCHR.Internal.Desugar.Disjunction
                    , YCHR.Internal.Desugar.Inline
                    , YCHR.Internal.Parser
                    , YCHR.Internal.Parsed
                    , YCHR.Internal.Parsing.Lexer
                    , YCHR.Internal.PExpr
                    , YCHR.Internal.Pretty
                    , YCHR.Internal.Rename
                    , YCHR.Internal.Rename.Types
                    , YCHR.Internal.StdLib
                    , YCHR.Internal.Types
                    , YCHR.Internal.TypeCheck
                    , YCHR.Internal.TypeCheck.Encode
                    , YCHR.Internal.TypeCheck.Error
                    , YCHR.Internal.TypeCheck.Render
                    , YCHR.Internal.TypeCheck.Compiled
                    , YCHR.Internal.Resolve
                    , YCHR.Internal.Resolved
                    , YCHR.Internal.Resources
                    , YCHR.Internal.VM
                    , YCHR.Internal.VM.Types
                    , YCHR.Internal.VM.SExpr
                    , YCHR.Internal.VM.Index
                    , YCHR.Internal.VM.Closure
                    , YCHR.Internal.SExpr
                    , YCHR.Internal.Runtime.Interpreter
                    , YCHR.Internal.Runtime.Monad
                    , YCHR.Internal.Runtime.Registry
                    , YCHR.Internal.Runtime.Session
                    , YCHR.Internal.Runtime.Goal
                    , YCHR.Internal.Runtime.Search
                    , YCHR.Internal.Runtime.Trail
                    , YCHR.Internal.Runtime.Types
                    , YCHR.Internal.Runtime.Var
                    , YCHR.Internal.Runtime.Store
                    , YCHR.Internal.Runtime.History
                    , YCHR.Internal.Runtime.Index
                    , YCHR.Internal.Runtime.Reactivation
                    , YCHR.Internal.Runtime.Error
                    , YCHR.Internal.Runtime.Trace

    other-modules:    YCHR.Internal.LineInput

    build-depends:    ansi-terminal >=0.11 && <1.2
                    , directory >=1.3 && <1.4
                    , parsec >=3.1 && <3.2
                    , transformers >=0.6 && <0.7

    hs-source-dirs:   src

    -- Per-compiler sources. Under GHC, 'src/ghc/' supplies the
    -- haskeline-backed 'YCHR.Internal.LineInput' and the Generic-derivation
    -- helpers; under MicroHs, 'src/mhs/' supplies the bare-'getLine'
    -- 'YCHR.Internal.LineInput'. The executable's own MicroHs overlay
    -- ('src/mhs/YCHR/Embedded.hs', the run-time resources provider) lives
    -- there too and is listed in its stanza below.
    if impl(ghc)
        hs-source-dirs:   src/ghc
        build-depends:    haskeline >=0.8 && <0.9
        -- GHC-only Generic-derivation helpers for "YCHR.Convert". Uses
        -- 'GHC.Generics', which MicroHs cannot compile; the core
        -- 'YCHR.Convert' stays Generics-free so it remains reachable there.
        exposed-modules:  YCHR.Convert.Generic
    if impl(mhs)
        hs-source-dirs:   src/mhs

    -- Base language which the package is written in.
    default-language: GHC2021
