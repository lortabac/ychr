(import (rnrs))
(define (binders-of f)
  (cond ((and (pair? f) (pair? (cdr f)))
         (cond ((eq? (car f) 'do) (map (lambda (b) (if (pair? b) (car b) b)) (cadr f)))
               ((symbol? (cadr f)) (list (cadr f)))
               ((pair? (cadr f)) (map (lambda (b) (if (pair? b) (car b) b)) (cadr f)))
               (else '())))
        (else '())))
(define (scan f bs path)
  (cond ((symbol? f)
         (when (and (eq? f 'a) (not (memq 'a bs)))
           (display "FREE a at ") (write path) (newline)))
        ((pair? f)
         (if (and (pair? (car f)) (memq (car (car f)) '(lambda let let* letrec do)))
             (scan (cdr f) (append (binders-of (car f)) bs) path)
             (begin (scan (car f) bs path) (scan (cdr f) bs path))))
        ((vector? f) (let loop ((i 0)) (when (< i (vector-length f))
                         (scan (vector-ref f i) bs path) (loop (+ i 1)))))))
(define p (open-input-file "scheme/ychr/runtime.sls"))
(let loop ((i 0))
  (let ((f (read p)))
    (unless (eof-object? f)
      (scan f '() (list 'form i))
      (loop (+ i 1)))))
