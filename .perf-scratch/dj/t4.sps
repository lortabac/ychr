(import (rnrs) (ychr runtime) (ychr generated program))
(define %s (program))
(display "AAA") (newline)
(let* ((X (make-var %s))
       (g (make-term (string->symbol ";")
                     (vector (make-term 'set (vector X 1))
                             (make-term 'set (vector X 2))))))
  (display "BBB start findall") (newline)
  (display "RESULT = ")
  (write (%findall %s X g))
  (newline))
