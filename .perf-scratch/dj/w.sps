(import (rnrs) (ychr runtime) (ychr pretty) (ychr generated program))
(display "loaded") (newline)
(force-output)
(let ((%s (program)))
  (display "session made") (newline) (force-output)
  (let* ((X (make-var %s)) (Ss (make-var %s)))
    (display "calling goal") (newline) (force-output)
    (guard (c (#t (display "GUARD: ") (write c) (newline)))
      (dj:go/2 %s X Ss))
    (display "returned") (newline)
    (pretty-bindings (list (cons 'Ss Ss) (cons 'X X)))))
