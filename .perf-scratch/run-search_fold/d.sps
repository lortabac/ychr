(import (rnrs) (ychr runtime) (ychr pretty)
        (ychr generated program))

(let ((%s (program)))
  (let* ((X (make-var %s))
         (Y (make-var %s))
         (Xs (make-var %s)))
    (search_fold:wider_template/3 %s X Y Xs)
    (pretty-bindings (list (cons (quote X) X) (cons (quote Xs) Xs) (cons (quote Y) Y)))
))
