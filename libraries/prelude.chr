% Imported implicitly and in full by every module. An import list on
% `use_module(library(prelude))` is rejected (YCHR-20019); resolve a
% clash with a prelude name by renaming your own identifier.

:- module(prelude, [
    type(bool/0),
    type(list/1),
    fun '+'/2,
    fun '-'/2,
    fun '*'/2,
    fun '/'/2,
    fun 'div'/2,
    fun 'mod'/2,
    fun 'rem'/2,
    fun '<'/2,
    fun '>'/2,
    fun '>='/2,
    fun '=<'/2,
    fun '=='/2,
    fun '\\=='/2,
    fun not/1,
    fun max/2,
    fun min/2,
    fun var/1,
    fun nonvar/1,
    fun integer/1,
    fun float/1,
    fun atom/1,
    fun boolean/1,
    fun string/1,
    fun ground/1,
    fun int_to_float/1,
    fun float_to_int/1,
    fun unifiable/2,
    fun term_variables/1,
    fun compound_to_list/1,
    fun list_to_compound/1,
    fun copy_term/1,
    fun write/1,
    fun nl/0,
    fun writeln/1,
    fun panic/1,
    fun call/2,
    fun call/3,
    fun call/4,
    fun call/5,
    fun call/6,
    fun call/7,
    fun call/8,
    fun call/9,
    fun call/10,
    fun call/11,
    tell_list/1,
    tell_list/2,
    tell_list/3,
    tell_list/4,
    tell_list/5,
    tell_list/6,
    tell_list/7,
    tell_list/8,
    tell_list/9,
    tell_list/10,
    op(500, yfx, '+'),
    op(500, yfx, '-'),
    op(400, yfx, '*'),
    op(400, yfx, '/'),
    op(400, yfx, div),
    op(400, yfx, mod),
    op(400, yfx, rem),
    op(700, xfx, '<'),
    op(700, xfx, '>'),
    op(700, xfx, '>='),
    op(700, xfx, '=<'),
    op(700, xfx, '=='),
    op(700, xfx, '\\==')
]).

:- chr_type bool ---> true ; false.

:- chr_type list(T) ---> [] ; [T|list(T)].

% Tell a whole list of goals: `tell_list(Gs, A1, ..., An)` tells each
% goal of `Gs` with `tell/N`, the trailing arguments appended to the
% goal's own, so it is the list counterpart of `tell` the way
% `maplist/2` is of `call/2`. A goal is an evaluated argument like any
% other, so a symbolic one is written `quote(note)` or
% `quote(note(X))`; a bare `note` is data and the renamer warns
% (YCHR-20101). `tell_list/1` appends nothing, so its elements must
% carry all their own arguments: it reaches `p(1)` written
% `quote(p(1))`, but a bare `quote(p)` reaches only `p/0`.
:- chr_constraint tell_list(list(any)),
                  tell_list(list(any), any),
                  tell_list(list(any), any, any),
                  tell_list(list(any), any, any, any),
                  tell_list(list(any), any, any, any, any),
                  tell_list(list(any), any, any, any, any, any),
                  tell_list(list(any), any, any, any, any, any, any),
                  tell_list(list(any), any, any, any, any, any, any, any),
                  tell_list(list(any), any, any, any, any, any, any, any, any),
                  tell_list(list(any), any, any, any, any, any, any, any, any, any).

% The overloaded operators are classes with one signature per type;
% `/`, `div`, `mod`, `rem` and `==` have one signature and are plain
% functions. A type mismatch on a class is YCHR-60006 (no matching
% overload), on a function YCHR-60001.
%
% `int` is arbitrary precision; `float` is the host's IEEE-754 double.
% Strings order by code point, case-sensitive, no locale. There is no
% mixed-type comparison: `1 < "a"` matches no signature (YCHR-60006).
:- class
    ('+'(int, int) -> int),
    ('+'(float, float) -> float).
:- class
    ('-'(int, int) -> int),
    ('-'(float, float) -> float).
:- class
    ('*'(int, int) -> int),
    ('*'(float, float) -> float).
:- class
    ('<'(int, int) -> bool),
    ('<'(float, float) -> bool),
    ('<'(string, string) -> bool).
:- class
    ('>'(int, int) -> bool),
    ('>'(float, float) -> bool),
    ('>'(string, string) -> bool).
:- class
    ('>='(int, int) -> bool),
    ('>='(float, float) -> bool),
    ('>='(string, string) -> bool).
:- class
    ('=<'(int, int) -> bool),
    ('=<'(float, float) -> bool),
    ('=<'(string, string) -> bool).

% The four `refining` clauses below declare refinement predicates: a
% guard calling one on a bare variable types that variable (see
% docs/reference/type-system.md). `atom/1` deliberately has none — a
% nullary constructor inhabits many types (`red`, `[]`, `true`) and the
% type grammar has no unions — and neither do `var`/`nonvar`/`ground`,
% whose success entails boundness rather than a type.
:- function
    ('/'(float, float) -> float),
    ('div'(int, int) -> int),
    ('mod'(int, int) -> int),
    ('rem'(int, int) -> int),
    ('=='(A, A) -> bool),
    ('\\=='(A, A) -> bool),
    (not(bool) -> bool),
    (var(any) -> bool),
    (nonvar(any) -> bool),
    (integer(any) -> bool refining int),
    (float(any) -> bool refining float),
    (atom(any) -> bool),
    (boolean(any) -> bool refining bool),
    (string(any) -> bool refining string),
    (ground(any) -> bool),
    (int_to_float(int) -> float),
    (float_to_int(float) -> int),
    (copy_term(A) -> A),
    (unifiable(any, any) -> bool),
    term_variables/1,
    (compound_to_list(any) -> list(any)),
    (list_to_compound(list(any)) -> any),
    (call(fun(A) -> B end, A) -> B),
    (call(fun(A, B) -> C end, A, B) -> C),
    (call(fun(A, B, C) -> D end, A, B, C) -> D),
    (call(fun(A, B, C, D) -> E end, A, B, C, D) -> E),
    (call(fun(A, B, C, D, E) -> F end, A, B, C, D, E) -> F),
    (call(fun(A, B, C, D, E, F) -> G end, A, B, C, D, E, F) -> G),
    (call(fun(A, B, C, D, E, F, G) -> H end, A, B, C, D, E, F, G) -> H),
    (call(fun(A, B, C, D, E, F, G, H) -> I end, A, B, C, D, E, F, G, H) -> I),
    (call(fun(A, B, C, D, E, F, G, H, I) -> J end, A, B, C, D, E, F, G, H, I) -> J),
    (call(fun(A, B, C, D, E, F, G, H, I, J) -> K end, A, B, C, D, E, F, G, H, I, J) -> K),
    (write(string) -> any),
    (nl() -> any),
    (writeln(string) -> any),
    (panic(string) -> any).

% Bounded: `>=` / `=<` are closed classes over int, float and string, so
% `max`/`min` work at exactly those types. A user type is YCHR-60012.
:- function max(T, T) -> T requiring '>='(T, T) -> bool.
:- function min(T, T) -> T requiring '=<'(T, T) -> bool.

% Every one of these is a thin wrapper around a single host call (or,
% for the arithmetic/comparison classes, the same wrapper shared by
% every overload), so each is eligible for `:- inline`: one equation,
% no guard, no prelude statement. `not/1` and `max`/`min` are not
% listed — each has two equations (one per pattern), so neither
% qualifies.
:- inline
    '+'/2, '-'/2, '*'/2, '/'/2, div/2, mod/2, rem/2,
    '<'/2, '>'/2, '>='/2, '=<'/2, '=='/2, '\\=='/2,
    var/1, nonvar/1, integer/1, float/1, atom/1, boolean/1, string/1, ground/1.

X + Y -> host:'+'(X, Y).

X - Y -> host:'-'(X, Y).

X * Y -> host:'*'(X, Y).

X / Y -> host:'/'(X, Y).

X div Y -> host:'div'(X, Y).

X mod Y -> host:'mod'(X, Y).

X rem Y -> host:'rem'(X, Y).

X < Y -> host:'<'(X, Y).

X > Y -> host:'>'(X, Y).

X >= Y -> host:'>='(X, Y).

X =< Y -> host:'=<'(X, Y).

X == Y -> host:'=='(X, Y).

% Boolean negation; `not(1)` matches no equation (YCHR-60001). `==` never
% binds, and two distinct unbound variables are not `==`. `\==` (below)
% is its ask-disequality counterpart; there is no `\=` (unifiability
% negation) — write `not(unifiable(X, Y))` for that.
% `bool` is an ordinary algebraic type, so this needs no host primitive:
% the two constructors are matchable in equation patterns like any other.
not(true) -> false.
not(false) -> true.

% Ask-disequality: true when the two arguments are not structurally
% identical after dereferencing. Never binds, so it is usable in a guard
% and leaves its operands intact. Two distinct unbound variables are
% `\==`; `X \== X` is false. Structural, not a unification test:
% `quote(p(X, 1)) \== quote(p(2, Y))` is true for distinct `X` and `Y`.
%
% In a quoted atom a backslash must itself be escaped, so the operator
% is declared as `'\\=='` (the `\\` escape), while written bare as
% `X \== Y`.
X \== Y -> not(X == Y).

max(X, Y) | X >= Y -> X.
max(_, Y) -> Y.

min(X, Y) | X =< Y -> X.
min(_, Y) -> Y.

% Type predicates take `any` and never raise on an unbound argument.
% `atom/1` is true for a bare atom and for a 0-arity constructor (they
% are the same value); `ground/1` means no unbound variable anywhere.
var(X) -> host:var(X).

nonvar(X) -> host:nonvar(X).

integer(X) -> host:integer(X).

float(X) -> host:float(X).

int_to_float(X) -> host:int_to_float(X).

float_to_int(X) -> host:float_to_int(X).

atom(X) -> host:atom(X).

boolean(X) -> host:boolean(X).

string(X) -> host:string(X).

ground(X) -> host:ground(X).

% Whether the two terms could unify. Binds nothing.
unifiable(X, Y) -> host:unifiable(X, Y).

% The unbound variables in a term, as a list.
term_variables(T) -> host:term_variables(T).

% `[Functor, Arg1, ...]`; `list_to_compound/1` is the inverse.
compound_to_list(C) -> host:compound_to_list(C).

list_to_compound(Xs) -> host:list_to_compound(Xs).

% `write`/`writeln` take a string: `write(1)` is a type error (a runtime
% error untyped). Render a term with meta's `write_term_to_string/1`, or
% use `print/1`.
write(S) -> host:write(S).

nl -> host:write("\n").

writeln(S) -> host:writeln(S).

% Abort the computation with a runtime error carrying the message `S`.
% It returns no value, so it fits any expression position. Render a term
% into the message with meta's `write_term_to_string/1`.
panic(S) -> host:panic(S).

% A copy with fresh variables.
copy_term(T) -> host:copy_term(T).

% Typed wrappers over the wired-in `'$call'`. One per supported call
% arity: `call/N` applies a callable to N-1 arguments, so the family
% spans `call/2` through `call/11` (one to ten arguments). The callable
% is named `Fn` so the argument names can run `A`..`K` without a clash.
call(Fn, A) -> '$call'(Fn, A).
call(Fn, A, B) -> '$call'(Fn, A, B).
call(Fn, A, B, C) -> '$call'(Fn, A, B, C).
call(Fn, A, B, C, D) -> '$call'(Fn, A, B, C, D).
call(Fn, A, B, C, D, E) -> '$call'(Fn, A, B, C, D, E).
call(Fn, A, B, C, D, E, F) -> '$call'(Fn, A, B, C, D, E, F).
call(Fn, A, B, C, D, E, F, G) -> '$call'(Fn, A, B, C, D, E, F, G).
call(Fn, A, B, C, D, E, F, G, H) -> '$call'(Fn, A, B, C, D, E, F, G, H).
call(Fn, A, B, C, D, E, F, G, H, I) -> '$call'(Fn, A, B, C, D, E, F, G, H, I).
call(Fn, A, B, C, D, E, F, G, H, I, J) -> '$call'(Fn, A, B, C, D, E, F, G, H, I, J).

% One pair of rules per arity: the empty list is done, and a non-empty
% one tells its head with the trailing arguments appended, then
% continues with the tail. `tell_list/1` has no trailing argument to
% append, which is why it is the `tell/1` case above.
tell_list([]) <=> true.
tell_list([G|Gs]) <=> tell(G), tell_list(Gs).

tell_list([], _A1) <=> true.
tell_list([G|Gs], A1) <=> tell(G, A1), tell_list(Gs, A1).

tell_list([], _A1, _A2) <=> true.
tell_list([G|Gs], A1, A2) <=> tell(G, A1, A2), tell_list(Gs, A1, A2).

tell_list([], _A1, _A2, _A3) <=> true.
tell_list([G|Gs], A1, A2, A3) <=> tell(G, A1, A2, A3), tell_list(Gs, A1, A2, A3).

tell_list([], _A1, _A2, _A3, _A4) <=> true.
tell_list([G|Gs], A1, A2, A3, A4) <=>
    tell(G, A1, A2, A3, A4), tell_list(Gs, A1, A2, A3, A4).

tell_list([], _A1, _A2, _A3, _A4, _A5) <=> true.
tell_list([G|Gs], A1, A2, A3, A4, A5) <=>
    tell(G, A1, A2, A3, A4, A5), tell_list(Gs, A1, A2, A3, A4, A5).

tell_list([], _A1, _A2, _A3, _A4, _A5, _A6) <=> true.
tell_list([G|Gs], A1, A2, A3, A4, A5, A6) <=>
    tell(G, A1, A2, A3, A4, A5, A6), tell_list(Gs, A1, A2, A3, A4, A5, A6).

tell_list([], _A1, _A2, _A3, _A4, _A5, _A6, _A7) <=> true.
tell_list([G|Gs], A1, A2, A3, A4, A5, A6, A7) <=>
    tell(G, A1, A2, A3, A4, A5, A6, A7), tell_list(Gs, A1, A2, A3, A4, A5, A6, A7).

tell_list([], _A1, _A2, _A3, _A4, _A5, _A6, _A7, _A8) <=> true.
tell_list([G|Gs], A1, A2, A3, A4, A5, A6, A7, A8) <=>
    tell(G, A1, A2, A3, A4, A5, A6, A7, A8),
    tell_list(Gs, A1, A2, A3, A4, A5, A6, A7, A8).

tell_list([], _A1, _A2, _A3, _A4, _A5, _A6, _A7, _A8, _A9) <=> true.
tell_list([G|Gs], A1, A2, A3, A4, A5, A6, A7, A8, A9) <=>
    tell(G, A1, A2, A3, A4, A5, A6, A7, A8, A9),
    tell_list(Gs, A1, A2, A3, A4, A5, A6, A7, A8, A9).
