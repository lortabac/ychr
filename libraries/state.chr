% Mutable variables, emulated with constraints. A stateful variable is
% declared with `:- state(Key, Type).`, which expands to a per-key API in
% the declaring module:
%
%   new_Key(V)      creates Key with initial value V
%   get_Key(R)      unifies R with the current value of Key
%   put_Key(V)      replaces the value of Key with V
%   modify_Key(F)   replaces the value of Key with F applied to it
%   close_Key       deletes Key, which may then be created again
%
% The value is held by a private `state_Key(Type)` constraint, and each
% request has the value type, so a request written directly in a rule is
% typed: `put_Key("a")` on an int key is a compile error. The key is an
% atom (or an integer) known at compile time: there is no runtime key and
% no dedicated unground-key error (an unbound key fails the dispatcher).
%
% `new_Key` and `close_Key` are the low-level API, exposed for
% completeness. The way to use a state variable is the scoped runner,
% after Haskell's runState:
%
%   run_state(K, V, quote(Goal))     the final value of K
%   run_states(KVs, quote(Goal))     the final kv(K, V) of each key of KVs
%
% The runner creates each key of the run at its initial value, runs the
% goal and reads the values back, so no key has to be closed by hand. The
% goal is a constraint term or a list of them, as for search:solve/1, and
% runs as solve/1 runs it, against a fork of the calling session
% (search.md, "Scope: search forks the calling session"): the keys are
% created there before the goal and read back after it, and the fork's
% store is discarded when the run returns. The reads happen before any
% choice point the goal leaves is explored, so write the goal
% deterministically: a goal that searches does not give the values of its
% solution.
%
% A runner dispatches on the key *value*, so a key named in the runner is
% also a data constructor: declare `:- chr_type key ---> k ; n.` to write
% `kv(k, 1)`, as the pairs library's own `kv/2` wants. An integer key
% (`:- state(1, int).`, `kv(1, V)`) needs no declaration.
%
% The goal's constraints are told with the prelude's `tell_list/1`, so
% they resolve program-wide by their bare spelling: a generated name must
% stay unique across the program, and the goal's own constraints must be
% nameable that way. A dynamically told goal is not type-checked at all:
% a mistyped `kv(K, V)` is accepted and runs, and only a goal that names
% no constraint is an error. A runtime error propagates, and a run whose
% goal has no solution is a runtime error too.
%
% The type is fixed at the declaration and must be ground (`int`,
% `string`, `list(int)`, ...); a type variable (or `_`) makes the holder
% polymorphic, and the generated rules then fail the type checker. The
% runner's own list is `list(pair(K, any))`, like master's, so one
% `run_states` may carry keys of different value types.

:- module(state, [macro(state/2),
                  fun run_state/3, fun run_states/2,
                  fun new_goal/2, fun get_goal/2,
                  fun not_initialized/0, fun already_initialized/0]).

:- use_module(library(lists)).
:- use_module(library(pairs)).
:- use_module(library(search)).

% The per-key goal builders the runner maps over its keys. A `:- state/2`
% use adds one equation per function, in the declaring module, keyed on
% the key atom.
:- open_function new_goal/2.
:- open_function get_goal/2.

:- function
    (run_state(any, any, any) -> any),
    (run_states(list(pair(K, any)), any) -> list(pair(K, any))),
    (run_with(list(pair(K, any)), any, list(pair(K, any)))
        -> list(pair(K, any))),
    (run_in_fork(list(any)) -> bool),
    (run_result(bool, list(pair(K, any))) -> list(pair(K, any))),
    (new_goal_of(pair(K, any)) -> any),
    (get_goal_of(pair(K, any)) -> any),
    (fresh_value(pair(K, any)) -> pair(K, any)),
    (goal_list(any) -> list(any)),
    (kv_list(any) -> bool),
    (is_kv(any) -> bool),
    (not_initialized() -> any),
    (already_initialized() -> any).

run_state(K, V, G) -> value(head(run_states([kv(K, V)], G))).

run_states(KVs, _) | not(kv_list(KVs)) ->
    panic("state: run_states expects a list of kv(K, V)").
run_states(KVs, G) -> run_with(KVs, G, maplist(fun fresh_value/1, KVs)).

run_with(KVs, G, Out) ->
    run_result(run_in_fork(append(maplist(fun new_goal_of/1, KVs),
                                  append(goal_list(G),
                                         maplist(fun get_goal_of/1, Out)))),
               Out).

new_goal_of(P) -> new_goal(key(P), value(P)).

get_goal_of(P) -> get_goal(key(P), value(P)).

% The goals go through the prelude's `tell_list/1`, which reaches a
% generated name the run's module keeps to itself.
run_in_fork(Gs) -> search:solve([quote(tell_list(Gs))]).

run_result(true, Out) -> Out.
run_result(false, _) ->
    panic("state: the goal of a run has no solution").

fresh_value(kv(K, _)) -> kv(K, _).

goal_list(G) | is_list(G) -> G.
goal_list(G) -> [G].

kv_list(L) | is_list(L) -> all(fun is_kv/1, L).
kv_list(_) -> false.

is_kv(kv(_, _)) -> true.
is_kv(_) -> false.

% The request that failed is a generated name with the key in it, so the
% message doesn't repeat the key: naming it here would mean passing a
% bare atom in an evaluated argument, which the renamer reports as an
% undeclared data constructor.
not_initialized -> panic("state: key is not initialized").

already_initialized -> panic("state: key is already initialized").

% The declaration macro. Rule order matters: `new`'s error rule comes
% before its init rule, and every other request's normal rule before its
% error rule, as in a hand-written library.
:- macro_decls state(Key, Type) --->
    [ (:- chr_constraint
            '$compound'('$atom'([state_, Key]), [Type]),
            '$compound'('$atom'([new_, Key]), [Type]),
            '$compound'('$atom'([get_, Key]), [Type]),
            '$compound'('$atom'([put_, Key]), [Type]),
            '$compound'('$atom'([modify_, Key]), [fun(Type) -> Type end]),
            '$compound'('$atom'([close_, Key]), [])),
      (:- constraint_use
              event('$atom'([new_, Key])/1),
              event('$atom'([get_, Key])/1),
              event('$atom'([put_, Key])/1),
              event('$atom'([modify_, Key])/1),
              event('$atom'([close_, Key])/0)),
      (:- extend_function new_goal(Key, V) ->
              quote('$compound'('$atom'([new_, Key]), [V]))),
      (:- extend_function get_goal(Key, R) ->
              quote('$compound'('$atom'([get_, Key]), [R]))),
      ('$compound'('$atom'([state_, Key]), [_]) \
           '$compound'('$atom'([new_, Key]), [_]) <=>
           state:already_initialized),
      ('$compound'('$atom'([new_, Key]), [V]) <=>
           '$compound'('$atom'([state_, Key]), [V])),
      ('$compound'('$atom'([state_, Key]), [V]) \
           '$compound'('$atom'([get_, Key]), [R]) <=> R = V),
      ('$compound'('$atom'([get_, Key]), [_]) <=>
           state:not_initialized),
      ('$compound'('$atom'([state_, Key]), [_]),
           '$compound'('$atom'([put_, Key]), [V]) <=>
           '$compound'('$atom'([state_, Key]), [V])),
      ('$compound'('$atom'([put_, Key]), [_]) <=>
           state:not_initialized),
      ('$compound'('$atom'([state_, Key]), [V]),
           '$compound'('$atom'([modify_, Key]), [F]) <=>
           '$compound'('$atom'([state_, Key]), [call(F, V)])),
      ('$compound'('$atom'([modify_, Key]), [_]) <=>
           state:not_initialized),
      ('$compound'('$atom'([state_, Key]), [_]),
           '$compound'('$atom'([close_, Key]), []) <=> true),
      ('$compound'('$atom'([close_, Key]), []) <=>
           state:not_initialized) ].
