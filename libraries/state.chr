:- module(state, [new_state/2, get/2, put/2, modify/2, close_state/1,
                  new_states/1, close_states/1,
                  fun run_state/3, fun run_states/2]).

:- use_module(library(lists)).
:- use_module(library(meta)).
:- use_module(library(pairs)).
:- use_module(library(search)).
:- use_module(library(strings)).

% Mutable variables, emulated with constraints. Each key names one
% stateful value, held by a private `state(K, V)` constraint:
%
%   new_state(K, V)  creates K with initial value V
%   get(K, R)        unifies R with the current value of K
%   put(K, V)        replaces the value of K with V
%   modify(K, F)     replaces the value V of K with F(V)
%   close_state(K)   deletes K, which may then be created again
%   new_states(KVs)  creates each key K of a list of kv(K, V), in order
%   close_states(Ks) deletes each key of a list, in order
%
% A key must be ground (an atom is the usual choice), and is matched
% with `==`. It must be created before it is read, updated or closed,
% and not created again until it is closed. Each of these is checked
% when the request is made, and a violation is a runtime error: a
% request on a non-ground key, `new_state` on a key that already exists,
% and `get`, `put`, `modify` or `close_state` on a key that does not
% exist.
%
% The argument of `new_states` must be a proper list of `kv(K, V)`, and
% that of `close_states` a proper list; this is checked before any
% element takes effect. Each element is then one `new_state` or
% `close_state` request, so the checks above apply to it (a key repeated
% in a `new_states` list is a `new_state` on a key that already exists),
% and the elements before a failing one have already taken effect.
%
% The scoped interface runs a goal against keys of its own, the way
% Haskell's runState runs a State computation:
%
%   run_state(K, V, quote(Goal))     the final value of K
%   run_states(KVs, quote(Goal))     the final kv(K, V) of each key of KVs
%
% The goal is a constraint term or a list of them, as for search:solve/1,
% and runs as solve/1 runs it, against a fork of the calling session
% (search.md, "Scope: search forks the calling session"): the keys are
% created there before the goal and read back after it, and the fork's
% store is discarded when the run returns, so there is nothing to close.
% The goal sees the caller's constraints, its keys included: a run on a
% key the caller holds is a `new_state` on a key that already exists.
% Nothing the goal tells or removes survives, and results come back
% through the returned value and the goal's own variables only. Its
% constraints must be exported, and are resolved through the exports of
% the whole program, as for any goal run by solve/1: qualify one
% (`state:get`) if another module exports the same name.
%
% A runtime error in the goal propagates, the state library's own
% included; a run whose goal fails (search:fail/0, or a choice point
% with no solution) is a runtime error too. The final values are read
% when the goal's tells have finished, before any choice point it left
% is explored, so a goal that searches does not give the values of its
% solution: write the goal deterministically. KVs is checked as for
% new_states. Both are Haskell-only, as library(search) is.

% The values are typed `any`. A key does not fix the type of its value
% (two keys may hold values of different types), and the checker types
% each head occurrence on its own, so a `V` shared between `state` and
% `get` would not be the same type in the rules below. A `new_states`
% list is an ordinary list, though, so its values do share one type
% unless they are themselves typed `any`.
:- chr_constraint state(K, any), new_state(K, any), get(K, any),
                  put(K, any), modify(K, fun(any) -> any end),
                  close_state(K), new_states(list(pair(K, any))),
                  close_states(list(K)), create_each(list(pair(K, any))),
                  close_each(list(K)).

% Requests are consumed by the rules below and never kept, and so are
% the private `create_each` and `close_each`.
:- constraint_use event(new_state/2), event(get/2), event(put/2),
                  event(modify/2), event(close_state/1),
                  event(new_states/1), event(close_states/1),
                  event(create_each/1), event(close_each/1).

:- function
    (key_error(any, string) -> any),
    (missing_key(any) -> any),
    (list_error(string, string, any) -> any),
    (kv_list(any) -> bool),
    (is_kv(any) -> bool),
    (run_state(K, any, any) -> any),
    (run_states(list(pair(K, any)), any) -> list(pair(K, any))),
    (run_with(list(pair(K, any)), any, list(pair(K, any)))
        -> list(pair(K, any))),
    (run_result(bool, list(pair(K, any))) -> list(pair(K, any))),
    (goal_list(any) -> list(any)),
    (fresh_value(pair(K, any)) -> pair(K, any)),
    (get_goal(pair(K, any)) -> any).

key_error(K, Problem) ->
    panic(string_concat("state: key ",
          string_concat(write_term_to_string(K), Problem))).

% A request that found no `state` for its key: either the key is not
% ground, so no `state` could ever match it, or it was never created.
missing_key(K) | ground(K) -> key_error(K, " is not initialized").
missing_key(K) -> key_error(K, " is not ground").

list_error(Request, Expected, L) ->
    panic(string_concat("state: ",
          string_concat(Request,
          string_concat(" expects ",
          string_concat(Expected,
          string_concat(", got ", write_term_to_string(L))))))).

kv_list(L) | is_list(L) -> all(fun is_kv/1, L).
kv_list(_) -> false.

is_kv(kv(_, _)) -> true.
is_kv(_) -> false.

% `new_state`'s error rules come before `init`. Every other request is
% tried against its own rule first, and its error rule fires only when
% that one could not.
new_unground @ new_state(K, _) <=> not(ground(K)) |
    key_error(K, " is not ground").
new_twice @ state(K, _) \ new_state(K, _) <=>
    key_error(K, " is already initialized").
init @ new_state(K, V) <=> state(K, V).

get @ state(K, V) \ get(K, R) <=> R = V.
get_missing @ get(K, _) <=> missing_key(K).

put @ state(K, _), put(K, V) <=> state(K, V).
put_missing @ put(K, _) <=> missing_key(K).

modify @ state(K, V), modify(K, F) <=> state(K, call(F, V)).
modify_missing @ modify(K, _) <=> missing_key(K).

close @ state(K, _), close_state(K) <=> true.
close_missing @ close_state(K) <=> missing_key(K).

% The list requests check their whole argument once, then hand it to a
% private constraint that walks it.
new_states_bad @ new_states(L) <=> not(kv_list(L)) |
    list_error("new_states", "a list of kv(K, V)", L).
new_states @ new_states(KVs) <=> create_each(KVs).

create_each([]) <=> true.
create_each([kv(K, V)|KVs]) <=> new_state(K, V), create_each(KVs).

close_states_bad @ close_states(L) <=> not(is_list(L)) |
    list_error("close_states", "a list", L).
close_states @ close_states(Ks) <=> close_each(Ks).

close_each([]) <=> true.
close_each([K|Ks]) <=> close_state(K), close_each(Ks).

% The library's own goals are qualified: a goal is resolved through the
% exports of the whole program, where an unqualified `get/2` would be
% ambiguous as soon as another module exports one.
%
% `run_states` asks for a fresh variable per key, then hands the same
% list to the goal's trailing `get`s and to the result: the `get`s bind
% the variables inside the fork, and they are goal variables, so
% committing its solution keeps them bound.
run_state(K, V, G) -> value(head(run_states([kv(K, V)], G))).

run_states(KVs, _) | not(kv_list(KVs)) ->
    list_error("run_states", "a list of kv(K, V)", KVs).
run_states(KVs, G) -> run_with(KVs, G, maplist(fun fresh_value/1, KVs)).

run_with(KVs, G, Out) ->
    run_result(solve([quote(state:new_states(KVs))
                      | append(goal_list(G), maplist(fun get_goal/1, Out))]),
               Out).

run_result(true, Out) -> Out.
run_result(false, _) -> panic("state: the goal of a run has no solution").

goal_list(G) | is_list(G) -> G.
goal_list(G) -> [G].

fresh_value(kv(K, _)) -> kv(K, _).

get_goal(kv(K, R)) -> quote(state:get(K, R)).
