:- module(meta, [
    fun print/1,
    fun read_term_from_string/1,
    fun write_term_to_string/1,
    fun write_store_to_list/0,
    fun print_store/0,
    fun run_chr_session/1,
    fun run_chr_session_ep/1,
    fun name_base/1
]).

:- function
    (print(any) -> any),
    (print_store() -> any),
    (read_term_from_string(string) -> any),
    (write_term_to_string(any) -> string),
    (write_store_to_list() -> list(any)),
    (run_chr_session(any) -> bool),
    (run_chr_session_ep(any) -> bool),
    (name_base(any) -> any).

print(X) -> host:print(X).

write_term_to_string(T) -> host:write_term_to_string(T).

read_term_from_string(S) -> host:read_term_from_string(S).

write_store_to_list -> host:write_store_to_list.

print_store -> host:print_store.

% Run a goal (a constraint term, or a list of them, wrapped in quote/1
% to keep it symbolic) in a fresh session of the current program: an
% empty store, history, and reactivation queue, same rules and
% functions. Neither the caller's constraints nor its choice points are
% visible. Goal constraints must be exported; an unknown one is a caller
% error.
%
% run_chr_session_ep/1 ("error-propagating") is search:solve/1 on such a
% fresh session rather than on a fork of the caller's store: same
% driver, same first-solution commit, and a runtime error in the goal
% propagates. run_chr_session/1 is the same made total: a runtime error
% inside the goal yields false instead of propagating, which makes it
% the language's only error catcher.
%
% Both return true if and only if the goal reaches a solution. A
% commit keeps only the values of the goal's variables -- the unbound
% variables reachable from the goal at the call -- so pass fresh
% out-variables to read results back. Everything else is undone,
% including every false. A commit onto a goal variable watched by a
% live stored constraint of the caller is a runtime error, from either
% entry point: pass a fresh variable and unify after.
%
% Worked examples, including nesting: test/golden/run_chr_session_test/.
run_chr_session(G) -> host:run_chr_session(G).

run_chr_session_ep(G) -> host:run_chr_session_ep(G).

% The local part of a name atom: `name_base(mod:foo)` is `foo`, and an
% unqualified `name_base(foo)` is `foo`. Two names have the same base
% exactly when their unqualified spellings match, which is what makes
% this the operation for asking "is this a reference to a name declared
% in some module?" without knowing the module. Errors on a non-atom; an
% unbound argument is an instantiation failure (a guard delays).
name_base(A) -> host:name_base(A).
