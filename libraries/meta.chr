:- module(meta, [
    fun print/1,
    fun read_term_from_string/1,
    fun write_term_to_string/1,
    fun write_store_to_list/0,
    fun print_store/0,
    fun run_chr_session/1,
    fun name_base/1
]).

:- function
    (print(any) -> any),
    (print_store() -> any),
    (read_term_from_string(string) -> any),
    (write_term_to_string(any) -> string),
    (write_store_to_list() -> list(any)),
    (run_chr_session(any) -> bool),
    (name_base(any) -> any).

print(X) -> host:print(X).

write_term_to_string(T) -> host:write_term_to_string(T).

read_term_from_string(S) -> host:read_term_from_string(S).

write_store_to_list -> host:write_store_to_list.

print_store -> host:print_store.

% Run a goal (a constraint term, or a list of them, wrapped in quote/1
% to keep it symbolic) in a fresh session of the current program: own
% store, history, and reactivation queue, same rules and functions.
% Goal constraints must be exported; an unknown one is a caller error.
% Returns true if and only if the sub-session runs to quiescence, and
% false otherwise -- a runtime error, or (inside a search branch) a
% search:fail/0. Bindings made before the failure are not rolled back. Unbound variables inside the goal are shared
% with the sub-session, so bindings made there survive the call — pass
% fresh out-variables to read results back. Reactivation does not
% cross the boundary: a live stored constraint of one session must not
% depend on a variable the other session binds.
run_chr_session(G) -> host:run_chr_session(G).

% The local part of a name atom: `name_base(mod:foo)` is `foo`, and an
% unqualified `name_base(foo)` is `foo`. Two names have the same base
% exactly when their unqualified spellings match, which is what makes
% this the operation for asking "is this a reference to a name declared
% in some module?" without knowing the module. Errors on a non-atom.
name_base(A) -> host:name_base(A).
