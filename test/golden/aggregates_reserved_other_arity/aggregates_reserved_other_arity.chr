% Only the five exact (name, arity) pairs (and ?/1) are reserved. Other
% arities of the same names, a data constructor at the exact
% reserved arity, and a declaration macro at the exact reserved
% name/arity all stay legal, alongside a real aggregate.
:- module(aggregates_reserved_other_arity).
:- use_module(library(aggregates)).

:- chr_constraint argmin/3, k/1, p/0, best/1, best3/1, show/1,
   main/1, ask/1, agg_result/1, mk_call/1, is_arg/1, lambda_arg/1.

% ?/1 is the aggregate guard; ?/2 is an ordinary name, and a
% declaration macro at ?/1 is fine.
:- chr_constraint '?'/2, q_two/1, q_ask/1.
'?'(A, B) \ q_ask(R) <=> R is A + B.
q_two(R) <=> '?'(1, 2), q_ask(R).

:- macro_decls '?'/1.
'?'(Name) ---> [(:- chr_constraint '$compound'(Name, [any]))].
:- '?'(guard_note).

:- function takemax/3.
takemax(X, Y, Z) -> X + Y + Z.

:- chr_type pair ---> argmax(int, int).

% The data constructor also works in a function body, an 'is' RHS and a lambda body.
:- function mk/2.
mk(A, B) -> argmax(A, B).

mk_call(R) <=> R is mk(1, 2).
is_arg(R) <=> R is argmax(1, 2).
lambda_arg(R) <=> R is '$call'(fun(A) -> argmax(A, A) end, 3).

:- macro_decls argmin/2.
argmin(Name, Arity) ---> [(:- chr_constraint '$compound'(Name, [Arity]))].
:- argmin(extra_note, any).

p, argmin(X, k(X)) ==> best(X).
best(X) \ ask(R) <=> R = X.
argmin(_, _, _) \ best3(R) <=> R = 0.
show(argmax(A, B)) <=> A >= 0, B >= 0 | true.

main(R) <=> k(3), k(1), p, show(argmax(1, 2)), R is takemax(1, 2, 3).

agg_result(R) <=> k(3), k(1), p, ask(R).
