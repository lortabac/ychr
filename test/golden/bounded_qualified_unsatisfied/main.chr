:- module(main, [result/1]).
:- use_module(lib).
:- use_module(library(prelude)).

:- chr_constraint result(any).

:- function pick_max(T, T) -> T requiring lib:gt(T, T) -> bool.
pick_max(X, Y) | lib:gt(X, Y) -> X.
pick_max(_, Y) -> Y.

% Bound unsatisfied: there is no lib:gt(string, string) -> bool.
result(R) <=> R is pick_max("a", "b").
