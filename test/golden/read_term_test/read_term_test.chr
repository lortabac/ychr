:- module(read_term_test, [go/2, is_bool/2, matches/2, observed/1, type(answer/0)]).

:- use_module(library(meta)).

:- chr_constraint go/2.

go(S, R) <=> R is read_term_from_string(S).

% A parsed `true` / `false` is the boolean, not an atom that merely
% prints like one: it has to answer `boolean/1` and match a bool head
% pattern. Both spellings print as "true", so only these tests tell the
% two representations apart.
:- chr_type answer ---> yes ; no.
:- chr_constraint is_bool(string, bool), matches(string, any), tagged(bool, any).

is_bool(S, R) <=> X is read_term_from_string(S), R is boolean(X).

matches(S, R) <=> X is read_term_from_string(S), tagged(X, R).
tagged(true, R) <=> R = yes.
tagged(false, R) <=> R = no.

% A parsed `_` is a fresh logical variable, exactly as in source: the
% constraint told with it observes it, so `f`'s own `N = 1` binding
% sticks and `chk(1)` fires. Were `read_term_from_string("_")` still the
% non-binding wildcard value, `N = 1` would be a silent no-op and
% `chk(1)` would never be told, leaving `R` unbound.
:- chr_constraint observed/1, f/1, chk/1, out/1, gather/1.

observed(R) <=> T is read_term_from_string("_"), f(T), gather(R).

f(N) <=> N = 1, chk(N).
chk(1) <=> out(1).

gather(R), out(V) <=> R = V.
