% A '$call' in a told constraint's argument is evaluated, so it gets
% no undeclared-constructor warning.
:- module(dynamic_call_tell_arg, [go/1]).
:- chr_constraint go/1, r/1, get/1.

:- function double/1.
double(X) -> X * 2.

go(R) <=> r('$call'(fun double/1, 3)), get(R).
r(X) \ get(R) <=> R = X.
