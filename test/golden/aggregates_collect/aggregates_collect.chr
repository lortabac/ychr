% collect: the list of elements, in goal order (the order the constraints
% were told, since the goal's loop takes the store's order).
:- module(aggregates_collect, [setup/1]).
:- use_module(library(aggregates)).

:- chr_constraint known/1, item/2, list_of/2, ask/1, setup/1.

known(X), collect(V, item(X, V), L) ==> list_of(X, L).

list_of(_, L) \ ask(A) <=> A = L.

setup(A) <=>
    item(1, 3),
    item(1, 1),
    item(1, 2),
    known(1),
    ask(A).
