:- module(state_run, [
    counted/1,
    pair_run/2,
    single/1,
    caller_key/2,
    close_in_run/1,
    unchecked/1,
    caller_clash/0,
    no_leak/1,
    missing_key/1,
    dup_keys/1,
    failing/1,
    unknown_goal/0,
    disjunction/1,
    out_var/2,
    unchecked_out/1,
    bad_kvs/2,
    nested/2,
    nested_clash/0
]).

:- use_module(library(state)).
:- use_module(library(pairs)).
:- use_module(library(search)).

% The runner dispatches on the key value, so a key is a declared
% constructor.
:- chr_type key ---> k ; n ; m.

:- state(k, int).
:- state(n, int).
:- state(m, int).

:- chr_constraint
    inc_k/0, inc_n/0, swap/0,
    counted/1, pair_run/2, single/1, caller_key/2, close_in_run/1,
    unchecked/1, caller_clash/0, no_leak/1, missing_key/1, dup_keys/1,
    failing/1, unknown_goal/0, disjunction/1,
    out_var/2, unchecked_out/1, bad_kvs/2, nested/2, nested_clash/0,
    nested_inner/1, clash_inner/0.

inc_k <=> get_k(V), put_k(V + 1).
inc_n <=> get_n(V), put_n(V + 1).
swap <=> get_k(A), get_n(B), put_k(B), put_n(A).

% The runner creates the listed keys, runs the goal and returns the
% final values.
counted(R) <=> R is run_state(k, 1, quote([inc_k, inc_k])).

pair_run(A, B) <=>
    [kv(k, A), kv(n, B)] is
        run_states([kv(k, 1), kv(n, 2)], quote([swap, inc_k])).

% An empty goal runs the init and the reads only.
single(R) <=> R is run_state(k, 5, quote([])).

% The goal sees the caller's keys: the run forks the caller's store.
caller_key(M, R) <=> new_m(3), R is run_state(n, 0, quote(get_m(M))).

% The low-level requests work inside a run too.
close_in_run(R) <=> R is run_state(k, 1, quote([close_k, new_k(2)])).

% The runner's values are dynamically typed, as on master: this creates
% `state_k("a")` for a key declared `int`.
unchecked(R) <=> [kv(k, R)] is run_states([kv(k, "a")], quote([])).

% Creating a key the caller already holds is a `new_k` on a key that
% exists.
caller_clash <=> new_k(5), _ is run_state(k, 0, quote([])).

% The run's store is discarded when it returns.
no_leak(R) <=> _ is run_state(k, 1, quote([])), get_k(R).

% A goal that reads a key the run did not create.
missing_key(R) <=> R is run_state(k, 1, quote(get_n(_))).

% Two entries for the same key.
dup_keys(R) <=> R is run_states([kv(k, 1), kv(k, 2)], quote([])).

failing(R) <=> R is run_state(k, 1, quote(try_unify(1, 2))).

unknown_goal <=> _ is run_state(k, 1, quote(nope(1))).

% The runner tells its goals one by one, so a `;` disjunction is not a
% tellable element.
disjunction(R) <=> R is run_state(k, 1, quote((inc_k ; inc_k))).

% The goal's own variables are committed with the run's values.
out_var(Mid, Final) <=>
    Final is run_state(k, 1, quote([inc_k, get_k(Mid), inc_k])).

% The final value is read back unchecked too: the goal stores a string in
% an `int` key.
unchecked_out(R) <=>
    [kv(k, R)] is run_states([kv(k, 1)], quote(put_k("z"))).

% A `KVs` that is not a proper list of `kv(K, V)`.
bad_kvs(L, R) <=> R is run_states(L, quote([])).

% A run inside a run. The inner goal forks the outer run's store, so it
% has to use a key of its own ...
nested_inner(I) <=> I is run_state(n, 0, quote(inc_n)).

nested(Outer, Inner) <=>
    Outer is run_state(k, 10, quote([inc_k, nested_inner(Inner)])).

% ... and one on the outer key is a `new_k` on a key that exists.
clash_inner <=> _ is run_state(k, 0, quote([])).

nested_clash <=> _ is run_state(k, 10, quote(clash_inner)).
