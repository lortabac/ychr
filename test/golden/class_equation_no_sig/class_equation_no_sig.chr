:- module(class_equation_no_sig, [size/1]).
:- use_module(prelude).

% The equation returns a list, but every declared signature returns
% int: it type-checks under no signature, which is
% NoMatchingOverload (class-equation checking used to be vacuous —
% one flexible-parameter check that every signature survived).
:- class (size(int) -> int), (size(string) -> int).
size(N) -> [N].
