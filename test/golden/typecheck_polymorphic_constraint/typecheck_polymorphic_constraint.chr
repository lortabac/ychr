:- module(tc, [box/1, run/2, type(tags/0)]).
:- use_module(prelude).
:- chr_constraint box(T), run/2.
:- chr_type tags ---> int_case ; str_case ; wrap_case.
:- chr_type wrap(A) ---> wrap(A).

% Polymorphic constraint box(T): each use site instantiates T.
% This program uses box at int, string, and wrap(int) — three
% monomorphic instantiations of the same polymorphic declaration. (A
% list would not do: a constraint's type parameter must be a determined
% type, see rigid_merge_undetermined.)
run(int_case, R) <=> box(42), R = ok.
run(str_case, R) <=> box("hi"), R = ok.
run(wrap_case, R) <=> box(wrap(1)), R = ok.
