:- module(residual_retry, [dup/1]).
:- use_module(prelude).

:- function (s(string) -> string).
s(X) -> X.

% X is extracted from the list pattern at a fresh flexible element
% type, so at `X + X` the overload resolution is still ambiguous and
% stays pending; `s(X)` then pins X to string, the pending resolution
% is retried, and its candidate set is empty — reported whenever that
% happens. The old one-shot resolution discarded the pending check at
% the ambiguous stage, so the body silently passed.
:- function dup/1.
dup([X | _]) -> [X + X, s(X)].
