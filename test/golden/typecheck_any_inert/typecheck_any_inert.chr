:- module(tc, [foo/1, bar/1, baz/1]).
:- chr_constraint foo(any), bar(int), baz(string).
% Spec §The role of `any`, "any stops propagation": X is typed `any`
% (its only declaration source is foo's `any` position), so X = Y and
% X = Z both succeed without propagating anything — Y stays int and
% Z stays string even though they meet the same X.
mix @ foo(X), bar(Y), baz(Z) <=> X = Y, X = Z.
