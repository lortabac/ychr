% M's type comes from one item match. The sibling count links M to int,
% but only for its own matches, and it may have none: with item("x") and
% no q, the rule would tell use_int("x").
:- module(aggregates_typed_sibling_link, []).
:- use_module(library(aggregates)).
:- chr_constraint item(T), snap, q(int), use_int(int).
snap, collect(Y, item(Y), [M]), count(q(M), _) ==> use_int(M).
