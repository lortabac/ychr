:- module(gecpbr, [go/1]).
:- use_module(library(prelude)).

% A whole rigid T shared with a box(int) position pins only the
% outermost constructor: T := box(B) with B itself RIGID and
% unrelated to int (spec §What evidence does; the same discipline as
% typecheck_head_match_beta_rigid, reached through GuardEqual
% instead of GuardMatch). Telling outb(Y) then meets box(int)
% against box(B) and is rejected at B.
:- chr_type box(A) ---> box(A).
:- chr_constraint p(T, T).
:- chr_constraint q(box(int)).
:- chr_constraint outb(box(int)), go(any).

bad @ p(X, Y), q(X) <=> outb(Y).

seed @ go(_) <=> p(box(1), box(2)), q(box(3)).
