:- module(maybe_library, [
    mapped/2,
    mapped2/3,
    bound/2,
    chained/1,
    predicates/2,
    defaults/2,
    folded/2,
    maybeness/4,
    presence/2
]).

:- use_module(library(maybe)).

:- chr_constraint
    mapped/2,
    mapped2/3,
    bound/2,
    chained/1,
    predicates/2,
    defaults/2,
    folded/2,
    maybeness/4,
    presence/2.

% The `refining` clause at work. `T` is rigid at this equation, so
% `is_just(X)` -- which demands a `maybe(A)` -- would be rejected
% without the guard, whose fact supplies exactly that. An unbound
% argument takes the second equation, because `is_maybe/1` answers
% `false` rather than raising on one.
:- function present(T) -> bool.
present(X) | is_maybe(X) -> is_just(X).
present(_) -> false.

mapped(A, B) <=>
    A is map_maybe(fun(X) -> X * 3 end, just(4)),
    B is map_maybe(fun(X) -> X * 3 end, nothing).

mapped2(A, B, C) <=>
    A is map_maybe(fun(X, Y) -> X + Y end, just(1), just(2)),
    B is map_maybe(fun(X, Y) -> X + Y end, just(1), nothing),
    C is map_maybe(fun(X, Y) -> X + Y end, nothing, just(2)).

bound(A, B) <=>
    A is maybe_and_then(just(2), fun(X) -> just(X + 1) end),
    B is maybe_and_then(nothing, fun(X) -> just(X + 1) end).

% The two operator spellings of `maybe_and_then/2`. Both bind tighter
% than `is` (750), so no extra parentheses are needed.
chained(R) <=>
    R is just(2) >>= fun(X) -> just(X + 1) end
                >>= fun(Y) -> just(Y * 10) end.

predicates(A, B) <=>
    A is is_just(fun(X) -> just(X) end =<< just(1)),
    B is is_nothing(fun(X) -> just(X) end =<< nothing).

defaults(A, B) <=>
    A is from_maybe(0, just(7)),
    B is from_maybe(0, nothing).

folded(A, B) <=>
    A is foldr_maybe(0, fun(X) -> X + 100 end, just(5)),
    B is foldr_maybe(0, fun(X) -> X + 100 end, nothing).

% `is_maybe/1` takes `any`, so unlike `is_just/1` and `is_nothing/1` it
% answers over values that are not `maybe`s at all.
maybeness(A, B, C, D) <=>
    A is is_maybe(just(1)),
    B is is_maybe(nothing),
    C is is_maybe(7),
    D is is_maybe([1]).

presence(V, R) <=> R is present(V).
