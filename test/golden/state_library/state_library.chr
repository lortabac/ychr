:- module(state_library, [
    new_get/1,
    put_replace/1,
    modified/1,
    independent/2,
    get_twice/2,
    close_reopen/1,
    get_uninit/1,
    put_uninit/0,
    modify_uninit/0,
    close_uninit/0,
    new_twice/0,
    close_get/1
]).

:- use_module(library(state)).

% The runner dispatches on the key value, so a key is a declared
% constructor. Only the low-level API needs it here.
:- chr_type key ---> k ; n ; name.

% One declaration per stateful variable. The value types are fixed here,
% so the generated requests are typed.
:- state(k, int).
:- state(n, int).
:- state(name, string).

:- chr_constraint
    new_get/1,
    put_replace/1,
    modified/1,
    independent/2,
    get_twice/2,
    close_reopen/1,
    get_uninit/1,
    put_uninit/0,
    modify_uninit/0,
    close_uninit/0,
    new_twice/0,
    close_get/1.

new_get(R) <=> new_k(1), get_k(R).

put_replace(R) <=> new_k(1), put_k(2), get_k(R).

modified(R) <=>
    new_n(0),
    modify_n(fun(X) -> X + 1 end),
    modify_n(fun(X) -> X * 10 end),
    get_n(R).

% Two keys holding values of different types.
independent(A, B) <=>
    new_k(1), new_name("x"),
    modify_k(fun(X) -> X + 1 end),
    get_k(A), get_name(B).

% `get` does not consume the value.
get_twice(A, B) <=> new_k(3), get_k(A), get_k(B).

% A closed key can be created again.
close_reopen(R) <=>
    new_k(1), close_k, new_k(2), get_k(R).

% Misuse is a runtime error, raised when the request is made.
get_uninit(R) <=> get_k(R).

put_uninit <=> put_k(1).

modify_uninit <=> modify_k(fun(X) -> X end).

close_uninit <=> close_k.

new_twice <=> new_k(1), new_k(2).

close_get(R) <=> new_k(1), close_k, get_k(R).
