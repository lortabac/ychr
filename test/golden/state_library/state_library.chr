:- module(state_library, [
    put_get/1,
    put_replace/1,
    modified/1,
    independent/2,
    get_before_put/1,
    modify_before_put/1,
    pending_order/2,
    retyped/1,
    get_twice/2
]).

:- use_module(library(state)).

:- chr_type key ---> k ; n ; count ; name.

:- chr_constraint
    put_get/1,
    put_replace/1,
    modified/1,
    independent/2,
    get_before_put/1,
    modify_before_put/1,
    pending_order/2,
    retyped/1,
    get_twice/2.

put_get(R) <=> put(k, 1), get(k, R).

put_replace(R) <=> put(k, 1), put(k, 2), get(k, R).

modified(R) <=>
    put(n, 0),
    modify(n, fun(X) -> X + 1 end),
    modify(n, fun(X) -> X * 10 end),
    get(n, R).

% Two keys holding values of different types.
independent(A, B) <=>
    put(count, 1), put(name, "x"),
    modify(count, fun(X) -> X + 1 end),
    get(count, A), get(name, B).

% The documented behaviour of the unenforced invariant: a `get` on a key
% with no value waits in the store and fires once the key is put.
get_before_put(R) <=> get(k, R), put(k, 7).

modify_before_put(R) <=>
    modify(k, fun(X) -> X + 1 end), put(k, 1), get(k, R).

% Pending requests are not served in tell order: when the key is put,
% every pending `get` sees the value it was put with, before any pending
% `modify` runs.
pending_order(A, B) <=>
    modify(k, fun(X) -> X + 1 end), get(k, A), put(k, 0), get(k, B).

% A key may be overwritten with a value of a different type.
retyped(R) <=> put(k, 1), put(k, "a"), get(k, R).

% `get` does not consume the value.
get_twice(A, B) <=> put(k, 3), get(k, A), get(k, B).
