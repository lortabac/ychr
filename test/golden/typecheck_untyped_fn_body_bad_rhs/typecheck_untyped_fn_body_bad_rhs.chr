:- module(tc, [go/1]).
:- use_module(prelude).
:- chr_constraint go/1.
:- function f/1.
% f/1 is untyped — equivalent to f(any) -> any (spec §Defaults) —
% but its equation body is still type-checked: `+` has no overload
% consistent with a string second argument.
f(X) -> X + "b".
go(R) <=> R is f(1).
