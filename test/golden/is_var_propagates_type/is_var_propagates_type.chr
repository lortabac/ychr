:- module(ivpt, [go/1]).
:- use_module(prelude).

% The `is` RHS is an evaluated position, so `Sum is 1 + 1` types Sum
% as int. The plain `=` that follows then carries that int into S,
% which the head declares string — a type error.
%
% The `=` form of the first goal would NOT be an error: `=` is
% structural, so `Sum = 1 + 1` binds Sum to a symbolic compound
% typed `any`, and `any` does not propagate — see the positive twin
% typecheck_unify_structural.
:- chr_constraint go(string).

go(S) <=> Sum is 1 + 1, S = Sum.
