% argmin picks the match with the smallest key. The rule fires once per
% p(K): a smaller item told later does not fire it again.
:- module(aggregates_argmin, [setup/2]).
:- use_module(library(aggregates)).

:- chr_constraint p/1, item/2, best/2, ask/2, setup/2.

p(K), argmin(X, item(K, X)) ==> best(K, X).

ask(K, R), collect(X, best(K, X), L) <=> R = L.

setup(A, B) <=>
    item(1, 5),
    item(1, 3),
    item(1, 9),
    p(1),
    item(1, 1),
    p(2),
    item(2, 7),
    item(2, 4),
    ask(1, A),
    ask(2, B).
