:- module(macro_decls_recursive).

% A recursive declaration macro: a nested use, written as a directive,
% takes the place of the nested use, so the constraints are declared in
% list order.
:- macro_decls unary_constraints/1.
unary_constraints([]) ---> [].
unary_constraints([C|Cs]) --->
    [ (:- chr_constraint C/1),
      (:- unary_constraints(Cs)) ].

% Used before its definition would be fine too; this one is after.
:- unary_constraints([red, green, blue]).

% One rule per name, generated by a second recursive macro.
:- macro_decls chain/1.
chain([_]) ---> [].
chain([A, B | Cs]) --->
    [ ('$compound'(A, [X]) ==> '$compound'(B, [X])),
      (:- chain([B | Cs])) ].

:- chain([red, green, blue]).

:- chr_constraint test/2, got/2.
test(X, R) <=> red(X), got(X, R).
blue(X) \ got(X, R) <=> R = X.
