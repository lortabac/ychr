:- module(lists_library, [
    mapped/1,
    filtered/1,
    filtered_none/1,
    folded/1,
    folded_left/1,
    reversed/1,
    zipped/1,
    zipped_short_first/1,
    quantified/2,
    quantified_flipped/2,
    empties/3,
    taken/2,
    dropped/2,
    concatenated/1,
    concat_mapped/1,
    replicated/2,
    distincted/1,
    sorted/1,
    sorted_ties/1,
    indexed/2
]).

:- use_module(library(lists)).

:- chr_constraint
    mapped/1,
    filtered/1,
    filtered_none/1,
    folded/1,
    folded_left/1,
    reversed/1,
    zipped/1,
    zipped_short_first/1,
    quantified/2,
    quantified_flipped/2,
    empties/3,
    taken/2,
    dropped/2,
    concatenated/1,
    concat_mapped/1,
    replicated/2,
    distincted/1,
    sorted/1,
    sorted_ties/1,
    indexed/2.

mapped(R) <=> R is maplist(fun(X) -> X * 2 end, [1, 2, 3]).

filtered(R) <=> R is filter(fun(X) -> X > 2 end, [1, 2, 3, 4, 1]).

filtered_none(R) <=> R is filter(fun(X) -> X > 9 end, [1, 2, 3]).

folded(R) <=> R is foldr(fun(X, Acc) -> [X * 2|Acc] end, [], [1, 2, 3]).

folded_left(R) <=> R is foldl(fun(Acc, X) -> [X|Acc] end, [], [1, 2, 3]).

reversed(R) <=> R is reverse([1, 2, 3]).

zipped(R) <=> R is zip_with(fun(X, Y) -> X + Y end, [1, 2, 3], [10, 20]).

zipped_short_first(R) <=> R is zip_with(fun(X, Y) -> X + Y end, [1], [10, 20]).

quantified(A, B) <=>
    A is all(fun(X) -> X > 0 end, [1, 2, 3]),
    B is any(fun(X) -> X > 2 end, [1, 2]).

% The other branch of each quantifier: the one that has to run the
% predicate and then take the *unguarded* equation.
quantified_flipped(A, B) <=>
    A is all(fun(X) -> X > 1 end, [1, 2, 3]),
    B is any(fun(X) -> X > 1 end, [1, 2]).

empties(A, B, C) <=>
    A is reverse([]),
    B is filter(fun(X) -> X > 0 end, []),
    C is foldr(fun(X, Acc) -> [X|Acc] end, [9], []).

taken(N, R) <=> R is take(N, [1, 2, 3]).

dropped(N, R) <=> R is drop(N, [1, 2, 3]).

concatenated(R) <=> R is concat([[1, 2], [], [3]]).

concat_mapped(R) <=> R is concat_map(fun(X) -> [X, X * 10] end, [1, 2]).

replicated(N, R) <=> R is replicate(N, 7).

% `==` decides what counts as a repeat, and the first occurrence is the
% one kept.
distincted(R) <=> R is distinct([3, 1, 3, 2, 1]).

sorted(R) <=> R is sort_by(fun(A, B) -> A < B end, [3, 1, 2]).

% An ordering that puts nothing strictly before anything leaves the
% input order untouched -- which is what stability means.
sorted_ties(R) <=> R is sort_by(fun(_, _) -> false end, [3, 1, 2]).

indexed(N, R) <=> R is nth_maybe(N, [1, 2, 3]).
