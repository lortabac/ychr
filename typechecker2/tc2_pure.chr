% The checks that need no solver.
%
% Three of the old checker's diagnostics are computed by pure Haskell
% over the declarations alone, never reaching CHR at all:
% `detectDuplicateConstructors`, `validateTypeDefinitions` and the
% constructor-arity walk (`ruleConstructorArities` and friends), all in
% `src/YCHR/Internal/TypeCheck.hs`. They port to ordinary functions
% here — an `error/3` term is data, so nothing has to be told.
%
% The port is meant to be diagnostic-for-diagnostic identical; the
% differential harness compares payloads, labels, locations and origins
% as multisets, so the only freedom is the order in which the lists are
% concatenated.
:- module('$tc2_pure', [
    fun program_errors/2
]).

:- use_module('$tc2_ast').
:- use_module('$tc2_diag').
:- use_module('$tc2_env').
:- use_module(library(lists)).
:- use_module(library(maybe)).
:- use_module(library(meta)).
:- use_module(library(pairs)).

% Every declaration-level diagnostic of one program. The constructor
% environment is passed in rather than built here: the checking walk
% needs the same one, and building it twice is the expensive half of
% this module.
:- function program_errors(con_env, program) -> list(error).
program_errors(Env, program(Rules, Funs, _, _, Tds)) ->
    all_errors(Env, Rules, Funs, Tds).

% Units are numbered by position: rule `i` is unit `i`, and the
% equations of the plain functions continue from there. The numbering
% need not match the old checker's — a unit id never leaves this
% program, and warning suppression only cares which diagnostics share
% one.
:- function all_errors(con_env, list(rule), list(fun_def), list(type_def)) -> list(error).
all_errors(Env, Rules, Funs, Tds) ->
    append(validate_type_defs(Tds),
      append(duplicate_constructors(Tds),
        append(rules_arity_errors(Env, Rules, 0),
               funs_arity_errors(Env, Funs, length(Rules))))).

% ---------------------------------------------------------------------
% Type-definition validation
% ---------------------------------------------------------------------
%
% Ports `validateTypeDefinitions` (TypeCheck.hs). Every constructor
% field of every declaration is walked; a field may only mention the
% enclosing declaration's own type parameters, and every type it
% references must be declared at the arity it is applied at.

:- function validate_type_defs(list(type_def)) -> list(error).
validate_type_defs(Tds) -> validate_tds(Tds, Tds).

:- function validate_tds(list(type_def), list(type_def)) -> list(error).
validate_tds([], _) -> [].
validate_tds([Td|Rest], All) ->
    append(validate_cons(Td, type_cons(Td), All), validate_tds(Rest, All)).

:- function validate_cons(type_def, list(data_con), list(type_def)) -> list(error).
validate_cons(_, [], _) -> [].
validate_cons(Td, [Dc|Dcs], All) ->
    append(validate_fields(Td, Dc, con_args(Dc), All), validate_cons(Td, Dcs, All)).

:- function validate_fields(type_def, data_con, list(ty_expr), list(type_def)) -> list(error).
validate_fields(_, _, [], _) -> [].
validate_fields(Td, Dc, [T|Ts], All) ->
    append(validate_field(Td, Dc, T, All), validate_fields(Td, Dc, Ts, All)).

:- function validate_field(type_def, data_con, ty_expr, list(type_def)) -> list(error).
% A type variable must be one of the enclosing declaration's parameters.
validate_field(Td, _, tvar(V), _) | member(V, type_def_vars(Td)) -> [].
validate_field(Td, Dc, tvar(V), _) ->
    [decl_error(Td, unbound_type_var,
                unbound_type_var_d(type_def_name(Td), con_name(Dc), V))].
% A function type names no declared type at either level, so only the
% components are validated. Mirrors the same special case in
% `validateFieldType`; the encoder has already recognized the
% `'->'(fun(...), Ret)` spelling and emitted `tfunx`.
validate_field(Td, Dc, tfunx(ArgTys, RetTy), All) ->
    validate_fields(Td, Dc, append(ArgTys, [RetTy]), All).
validate_field(Td, Dc, tconx(N, Args), All) ->
    append(type_ref_errors(Td, Dc, N, Args, All),
           validate_fields(Td, Dc, Args, All)).

% Whether the head of a type reference names something declared, and if
% not, which of the two diagnoses fits.
:- function type_ref_errors(type_def, data_con, any, list(ty_expr), list(type_def))
    -> list(error).
% Declared at exactly this arity: well-formed.
type_ref_errors(_, _, N, Args, All) | has_type_def(N, length(Args), All) -> [].
% A base type takes no arguments, so any application of one is an
% arity mismatch against a declared arity of zero.
type_ref_errors(Td, Dc, N, Args, _) | is_base_type(N), length(Args) > 0 ->
    [arity_ref_error(Td, Dc, N, length(Args), 0)].
type_ref_errors(_, _, N, _, _) | is_base_type(N) -> [].
% The renamer resolves type names by (name, arity), so a reference at
% the wrong arity never gets qualified and so never matches. When the
% base name is declared at exactly one other arity, say so instead of
% claiming the type does not exist.
type_ref_errors(Td, Dc, N, Args, All) ->
    sole_arity_error(Td, Dc, N, Args, base_name_arities(name_base(N), All)).

:- function sole_arity_error(type_def, data_con, any, list(ty_expr), list(int)) -> list(error).
sole_arity_error(Td, Dc, N, Args, [Declared]) ->
    [arity_ref_error(Td, Dc, N, length(Args), Declared)].
sole_arity_error(Td, Dc, N, _, _) ->
    [decl_error(Td, undefined_type,
                undefined_type_d(type_def_name(Td), con_name(Dc), N))].

:- function arity_ref_error(type_def, data_con, any, int, int) -> error.
arity_ref_error(Td, Dc, N, UseArity, Declared) ->
    decl_error(Td, type_ref_arity,
               type_ref_arity_d(type_def_name(Td), con_name(Dc), N, UseArity, Declared)).

% The four built-in base types, which have no declaration to find and
% take no parameters. The comparison is against the whole mangled
% atom, so a qualified `m:int` is correctly not one of them — the
% Haskell's explicit `Qualified _ _ -> False` arm needs no counterpart.
:- function is_base_type(any) -> bool.
is_base_type(N) | N == quote(int) -> true.
is_base_type(N) | N == quote(float) -> true.
is_base_type(N) | N == quote(string) -> true.
is_base_type(N) | N == quote(any) -> true.
is_base_type(_) -> false.

% A declaration-level diagnostic: no checking unit, so it suppresses no
% warnings, and the source echo is the enclosing type's own name.
:- function decl_error(type_def, any, any) -> error.
decl_error(Td, Code, Detail) ->
    error(ctx(-1, origin_atom(type_def_name(Td)), label_none, type_def_loc(Td)),
          Code, Detail).

% ---------------------------------------------------------------------
% Duplicate constructors
% ---------------------------------------------------------------------
%
% Ports `detectDuplicateConstructors`. Constructor lookups are keyed on
% name alone, so two declarations of one name collide whatever their
% arities, and the later would silently shadow the earlier.

% One declaration of a constructor: the declaring type's name, the
% constructor's arity there, and where that type is declared.
:- chr_type con_decl ---> con_decl(any, int, loc).

% One grouping pass, then one diagnostic per group of more than one.
% The old checker's `Map.fromListWith (++)` is reproduced by
% `push_decl`, which prepends: each group ends up in reverse encounter
% order, which is what the *stable* sort below then sees.
:- function duplicate_constructors(list(type_def)) -> list(error).
duplicate_constructors(Tds) -> dup_errors(group_decls(Tds, [])).

:- function group_decls(list(type_def), list(pair(any, list(con_decl))))
    -> list(pair(any, list(con_decl))).
group_decls([], Groups) -> Groups.
group_decls([Td|Tds], Groups) ->
    group_decls(Tds, td_decls(Td, type_cons(Td), Groups)).

:- function td_decls(type_def, list(data_con), list(pair(any, list(con_decl))))
    -> list(pair(any, list(con_decl))).
td_decls(_, [], Groups) -> Groups.
td_decls(Td, [Dc|Dcs], Groups) ->
    td_decls(Td, Dcs,
             push_decl(con_name(Dc),
                       con_decl(type_def_name(Td), length(con_args(Dc)),
                                type_def_loc(Td)),
                       Groups)).

:- function push_decl(any, con_decl, list(pair(any, list(con_decl))))
    -> list(pair(any, list(con_decl))).
push_decl(N, D, []) -> [kv(N, [D])].
push_decl(N, D, [kv(K, Ds)|Rest]) | K == N -> [kv(K, [D|Ds])|Rest].
push_decl(N, D, [G|Rest]) -> [G|push_decl(N, D, Rest)].

:- function dup_errors(list(pair(any, list(con_decl)))) -> list(error).
dup_errors([]) -> [].
dup_errors([kv(N, Ds)|Rest]) ->
    append(dup_error_for(N, sort_decls(Ds)), dup_errors(Rest)).

:- function dup_error_for(any, list(con_decl)) -> list(error).
dup_error_for(_, []) -> [].
dup_error_for(_, [_]) -> [].
dup_error_for(N, [con_decl(TName, A, L), D2|Ds]) ->
    [error(ctx(-1, origin_atom(TName), label_none, L),
           duplicate_constructor,
           duplicate_constructor_d(N, decl_pairs([con_decl(TName, A, L), D2|Ds])))].

:- function decl_pairs(list(con_decl)) -> list(pair(any, int)).
decl_pairs([]) -> [].
decl_pairs([con_decl(TName, A, _)|Ds]) -> [kv(TName, A)|decl_pairs(Ds)].

% Stable insertion sort by source position, on `(file, line, col)` —
% the same key `List.sortOn` uses. Two files may carry the same
% `:- module` header and are merged, so two declarations of one
% *qualified* constructor name really can sit in different files, and
% the file has to be part of the key: without it the reported
% declaration order, source location and origin all diverge from the
% old checker's. `<` on two strings is lexicographic by code point,
% which is the ordering `Ord String` gives.
:- function sort_decls(list(con_decl)) -> list(con_decl).
sort_decls([]) -> [].
sort_decls([D|Ds]) -> insert_decl(D, sort_decls(Ds)).

:- function insert_decl(con_decl, list(con_decl)) -> list(con_decl).
insert_decl(D, []) -> [D].
insert_decl(D, [E|Es]) | decl_before(E, D) -> [E|insert_decl(D, Es)].
insert_decl(D, [E|Es]) -> [D, E|Es].

% Strictly earlier, so that an insertion stops at the first element the
% newcomer does not follow — which is what keeps the sort stable.
:- function decl_before(con_decl, con_decl) -> bool.
decl_before(con_decl(_, _, loc(F1, _, _)), con_decl(_, _, loc(F2, _, _)))
  | F1 < F2 -> true.
decl_before(con_decl(_, _, loc(F1, _, _)), con_decl(_, _, loc(F2, _, _)))
  | F1 > F2 -> false.
decl_before(con_decl(_, _, loc(_, L1, _)), con_decl(_, _, loc(_, L2, _)))
  | L1 < L2 -> true.
decl_before(con_decl(_, _, loc(_, L1, C1)), con_decl(_, _, loc(_, L2, C2)))
  | L1 == L2, C1 < C2 -> true.
decl_before(_, _) -> false.

% ---------------------------------------------------------------------
% Constructor arity
% ---------------------------------------------------------------------
%
% Ports `ruleConstructorArities` / `functionConstructorArities`. A known
% constructor used at the wrong arity is reported directly rather than
% left to surface as a downstream type inconsistency, because the
% checking phase treats such a site as `any` and would otherwise say
% nothing about it.

% One offending use site: the constructor's canonical name, the arity
% it was applied at, and the arity it was declared with.
:- chr_type arity_use ---> arity_use(any, int, int).

:- function rules_arity_errors(con_env, list(rule), int) -> list(error).
rules_arity_errors(_, [], _) -> [].
rules_arity_errors(Env, [R|Rs], Unit) ->
    append(rule_arity_errors(Env, R, Unit), rules_arity_errors(Env, Rs, Unit + 1)).

% The head contributes nothing: after HNF every head argument is a
% variable or a wildcard, so a pattern's constructors have already
% become `guard_match` conjuncts and are found there.
:- function rule_arity_errors(con_env, rule, int) -> list(error).
rule_arity_errors(Env,
                  rule(Name, ann(_, _, _), ann(GAnn, GLoc, Guards), ann(BAnn, BLoc, Body)),
                  Unit) ->
    append(arity_diags(Unit, rule_label(Name), GAnn, GLoc, guards_arity(Env, Guards)),
           arity_diags(Unit, rule_label(Name), BAnn, BLoc, body_goals_arity(Env, Body))).

% A class function's equations are checked in throwaway per-signature
% sessions whose diagnostics are discarded, so the old checker collects
% their arity errors at program level instead — outside any unit.
:- function funs_arity_errors(con_env, list(fun_def), int) -> list(error).
funs_arity_errors(_, [], _) -> [].
funs_arity_errors(Env, [F|Fs], Unit) ->
    append(fun_arity_errors(Env, F, Unit),
           funs_arity_errors(Env, Fs, Unit + fun_unit_count(F))).

:- function fun_unit_count(fun_def) -> int.
fun_unit_count(fun_def(_, _, Sigs, _, ann(_, _, _))) | length(Sigs) > 1 -> 0.
fun_unit_count(fun_def(_, _, _, _, ann(_, _, Eqs))) -> length(Eqs).

:- function fun_arity_errors(con_env, fun_def, int) -> list(error).
fun_arity_errors(Env, fun_def(FName, _, Sigs, _, ann(A, Loc, Eqs)), _) | length(Sigs) > 1 ->
    eqs_arity_errors(Env, FName, A, Loc, Eqs, -1, 0).
fun_arity_errors(Env, fun_def(FName, _, _, _, ann(A, Loc, Eqs)), Unit) ->
    eqs_arity_errors(Env, FName, A, Loc, Eqs, Unit, 1).

:- function eqs_arity_errors(con_env, any, int, loc, list(fun_eq), int, int) -> list(error).
eqs_arity_errors(_, _, _, _, [], _, _) -> [].
eqs_arity_errors(Env, FName, A, Loc, [Eq|Eqs], Unit, Step) ->
    append(arity_diags(Unit, label_function(FName), A, Loc, eq_arity(Env, Eq)),
           eqs_arity_errors(Env, FName, A, Loc, Eqs, Unit + Step, Step)).

% Parameters are post-HNF head arguments and so contain no constructor
% application. The prelude statements are deliberately not walked:
% `eqArity` does not walk them either.
:- function eq_arity(con_env, fun_eq) -> list(arity_use).
eq_arity(Env, fun_eq(_, Guards, _, Rhs)) ->
    append(guards_arity(Env, Guards), expr_arity(Env, Rhs)).

:- function arity_diags(int, diag_label, int, loc, list(arity_use)) -> list(error).
arity_diags(_, _, _, _, []) -> [].
arity_diags(U, L, A, Loc, [arity_use(N, Use, Declared)|Rest]) ->
    [error(ctx(U, origin_ann(A), L, Loc), constructor_arity,
           constructor_arity_d(N, Use, Declared))
     | arity_diags(U, L, A, Loc, Rest)].

% --- The walk -------------------------------------------------------

:- function guards_arity(con_env, list(guard)) -> list(arity_use).
guards_arity(_, []) -> [].
guards_arity(Env, [G|Gs]) -> append(guard_arity(Env, G), guards_arity(Env, Gs)).

:- function guard_arity(con_env, guard) -> list(arity_use).
guard_arity(Env, guard_equal(A, B)) -> append(expr_arity(Env, A), expr_arity(Env, B)).
guard_arity(Env, guard_match(E, N, Arity)) ->
    append(check_arity(Env, N, Arity), expr_arity(Env, E)).
guard_arity(Env, guard_getarg(_, E, _)) -> expr_arity(Env, E).
guard_arity(Env, guard_expr(E)) -> expr_arity(Env, E).

:- function body_goals_arity(con_env, list(body_goal)) -> list(arity_use).
body_goals_arity(_, []) -> [].
body_goals_arity(Env, [G|Gs]) ->
    append(body_goal_arity(Env, G), body_goals_arity(Env, Gs)).

:- function body_goal_arity(con_env, body_goal) -> list(arity_use).
body_goal_arity(_, body_true) -> [].
body_goal_arity(Env, body_tell(_, Args)) -> exprs_arity(Env, Args).
body_goal_arity(Env, body_unify(A, B)) ->
    append(expr_arity(Env, A), expr_arity(Env, B)).
body_goal_arity(Env, body_host(_, Args)) -> exprs_arity(Env, Args).
body_goal_arity(Env, body_is(_, E)) -> expr_arity(Env, E).
body_goal_arity(Env, body_call(_, Args)) -> exprs_arity(Env, Args).
body_goal_arity(Env, body_apply(F, Args)) ->
    append(expr_arity(Env, F), exprs_arity(Env, Args)).

:- function exprs_arity(con_env, list(expr)) -> list(arity_use).
exprs_arity(_, []) -> [].
exprs_arity(Env, [E|Es]) -> append(expr_arity(Env, E), exprs_arity(Env, Es)).

% Only `ctor_e` is a constructor application. The heads of the other
% compounds name a function, a closure or a host call, so their
% children are walked but the head itself is not checked.
:- function expr_arity(con_env, expr) -> list(arity_use).
expr_arity(_, var_e(_)) -> [].
expr_arity(_, int_e(_)) -> [].
expr_arity(_, float_e(_)) -> [].
expr_arity(_, text_e(_)) -> [].
expr_arity(_, wild_e) -> [].
expr_arity(_, funref_e(_, _)) -> [].
expr_arity(Env, ctor_e(N, Args)) ->
    append(check_arity(Env, N, length(Args)), exprs_arity(Env, Args)).
expr_arity(Env, call_e(_, Args)) -> exprs_arity(Env, Args).
expr_arity(Env, apply_e(F, Args)) ->
    append(expr_arity(Env, F), exprs_arity(Env, Args)).
expr_arity(Env, host_e(_, Args)) -> exprs_arity(Env, Args).
expr_arity(Env, lambda_e(_, Body)) -> exprs_arity(Env, Body).

% An unknown name is not an arity error — a use site the environment
% does not recognize is left to the rest of the checker.
:- function check_arity(con_env, any, int) -> list(arity_use).
check_arity(Env, N, UseArity) -> check_canonical(Env, canonicalize_con(Env, N), UseArity).

:- function check_canonical(con_env, any, int) -> list(arity_use).
check_canonical(Env, N, UseArity) -> arity_use_of(N, UseArity, lookup_con(Env, N)).

:- function arity_use_of(any, int, maybe(con_info)) -> list(arity_use).
arity_use_of(_, _, nothing) -> [].
arity_use_of(N, UseArity, just(Info)) | not(con_arity(Info) == UseArity) ->
    [arity_use(N, UseArity, con_arity(Info))].
arity_use_of(_, _, just(_)) -> [].
