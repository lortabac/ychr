% Conformance walk over an encoded program.
%
% `src/YCHR/Internal/TypeCheck/Encode.hs` builds the ground term that
% `typechecker2/tc2_ast.chr` declares the shape of. Nothing else checks
% that the two agree: a constructor the encoder spells differently, or
% an argument it puts in the wrong position, produces a term that no
% rule matches — and a rule that does not match is silence, not a
% failure.
%
% `ast_size/1` visits every node of an encoded program and counts it.
% Every constructor of every AST type has an equation here, so a
% mis-encoded term hits no equation and raises YCHR-60001 naming the
% node that did not fit. The entry points in `tc2_main` call it, which
% means every program the checker ever sees is validated, and the
% type-checker's own `ychr check --Werror` pass validates these
% equations against the declarations in turn — a missing equation is
% YCHR-20103, non-exhaustive patterns.
%
% Nothing here may match a structured field with `_`: a field passed
% over is a field whose encoding nothing checks. That is why the rule
% name and the goal-checking label have walkers of their own despite
% having nothing underneath them worth counting.
%
% The count itself is not used. This module exists to make a
% mis-encoding loud, and should go away once the real walkers of M3–M6
% reach every node on their own.
:- module('$tc2_conform', [
    fun ast_size/1,
    fun body_goals_size/1,
    fun diag_label_size/1,
    fun loc_size/1
]).

:- use_module('$tc2_ast').
:- use_module('$tc2_diag').
:- use_module(library(maybe)).
:- use_module(library(pairs)).
:- use_module(library(strings)).

:- function ast_size(program) -> int.
ast_size(program(Rules, Funs, ConTypes, ConBounds, TypeDefs)) ->
    1 + rules_size(Rules)
      + fun_defs_size(Funs)
      + con_types_size(ConTypes)
      + con_bounds_size(ConBounds)
      + type_defs_size(TypeDefs).

% --- Rules ----------------------------------------------------------

:- function rules_size(list(rule)) -> int.
rules_size([]) -> 0.
rules_size([R|Rs]) -> rule_size(R) + rules_size(Rs).

:- function rule_size(rule) -> int.
rule_size(rule(Name, ann(_, HeadLoc, Head), ann(_, GuardLoc, Guards), ann(_, BodyLoc, Body))) ->
    1 + rule_name_size(Name)
      + loc_size(HeadLoc) + rule_head_size(Head)
      + loc_size(GuardLoc) + guards_size(Guards)
      + loc_size(BodyLoc) + body_goals_size(Body).

% Named rather than matched with `_`, so that the encoder's `maybe`
% spelling is checked too: it is the one structured wrapper the walk
% would otherwise pass over.
:- function rule_name_size(maybe(string)) -> int.
rule_name_size(nothing) -> 1.
rule_name_size(just(_)) -> 1.

:- function rule_head_size(rule_head) -> int.
rule_head_size(rule_head(Kept, Removed)) ->
    1 + head_cons_size(Kept) + head_cons_size(Removed).

:- function head_cons_size(list(head_con)) -> int.
head_cons_size([]) -> 0.
head_cons_size([H|Hs]) -> head_con_size(H) + head_cons_size(Hs).

:- function head_con_size(head_con) -> int.
head_con_size(head_con(_, Args)) -> 1 + head_args_size(Args).

:- function head_args_size(list(head_arg)) -> int.
head_args_size([]) -> 0.
head_args_size([A|As]) -> head_arg_size(A) + head_args_size(As).

:- function head_arg_size(head_arg) -> int.
head_arg_size(head_var(_)) -> 1.
head_arg_size(head_wild) -> 1.

% --- Guards, goals, statements --------------------------------------

:- function guards_size(list(guard)) -> int.
guards_size([]) -> 0.
guards_size([G|Gs]) -> guard_size(G) + guards_size(Gs).

:- function guard_size(guard) -> int.
guard_size(guard_equal(A, B)) -> 1 + expr_size(A) + expr_size(B).
guard_size(guard_match(E, _, _)) -> 1 + expr_size(E).
guard_size(guard_getarg(_, E, _)) -> 1 + expr_size(E).
guard_size(guard_expr(E)) -> 1 + expr_size(E).

:- function body_goals_size(list(body_goal)) -> int.
body_goals_size([]) -> 0.
body_goals_size([G|Gs]) -> body_goal_size(G) + body_goals_size(Gs).

:- function body_goal_size(body_goal) -> int.
body_goal_size(body_true) -> 1.
body_goal_size(body_tell(_, Args)) -> 1 + exprs_size(Args).
body_goal_size(body_unify(A, B)) -> 1 + expr_size(A) + expr_size(B).
body_goal_size(body_host(_, Args)) -> 1 + exprs_size(Args).
body_goal_size(body_is(_, E)) -> 1 + expr_size(E).
body_goal_size(body_call(_, Args)) -> 1 + exprs_size(Args).
body_goal_size(body_apply(F, Args)) -> 1 + expr_size(F) + exprs_size(Args).

:- function fun_stmts_size(list(fun_stmt)) -> int.
fun_stmts_size([]) -> 0.
fun_stmts_size([S|Ss]) -> fun_stmt_size(S) + fun_stmts_size(Ss).

:- function fun_stmt_size(fun_stmt) -> int.
fun_stmt_size(fun_is(_, E)) -> 1 + expr_size(E).
fun_stmt_size(fun_host(_, Args)) -> 1 + exprs_size(Args).
fun_stmt_size(fun_call(_, Args)) -> 1 + exprs_size(Args).
fun_stmt_size(fun_apply(F, Args)) -> 1 + expr_size(F) + exprs_size(Args).

% --- Expressions ----------------------------------------------------

:- function exprs_size(list(expr)) -> int.
exprs_size([]) -> 0.
exprs_size([E|Es]) -> expr_size(E) + exprs_size(Es).

:- function expr_size(expr) -> int.
expr_size(var_e(_)) -> 1.
expr_size(int_e(_)) -> 1.
expr_size(float_e(_)) -> 1.
expr_size(text_e(_)) -> 1.
expr_size(wild_e) -> 1.
expr_size(ctor_e(_, Args)) -> 1 + exprs_size(Args).
expr_size(call_e(_, Args)) -> 1 + exprs_size(Args).
expr_size(apply_e(F, Args)) -> 1 + expr_size(F) + exprs_size(Args).
expr_size(funref_e(_, _)) -> 1.
expr_size(lambda_e(Params, Body)) -> 1 + head_args_size(Params) + exprs_size(Body).
expr_size(host_e(_, Args)) -> 1 + exprs_size(Args).

% --- Functions ------------------------------------------------------

:- function fun_defs_size(list(fun_def)) -> int.
fun_defs_size([]) -> 0.
fun_defs_size([F|Fs]) -> fun_def_size(F) + fun_defs_size(Fs).

:- function fun_def_size(fun_def) -> int.
fun_def_size(fun_def(_, _, Sigs, Bounds, ann(_, Loc, Eqs))) ->
    1 + fun_sigs_size(Sigs) + bound_sigs_size(Bounds)
      + loc_size(Loc) + fun_eqs_size(Eqs).

:- function fun_sigs_size(list(fun_sig)) -> int.
fun_sigs_size([]) -> 0.
fun_sigs_size([S|Ss]) -> fun_sig_size(S) + fun_sigs_size(Ss).

:- function fun_sig_size(fun_sig) -> int.
fun_sig_size(fun_sig(Args, Ret)) -> 1 + ty_exprs_size(Args) + ty_expr_size(Ret).

:- function bound_sigs_size(list(bound_sig)) -> int.
bound_sigs_size([]) -> 0.
bound_sigs_size([B|Bs]) -> bound_sig_size(B) + bound_sigs_size(Bs).

:- function bound_sig_size(bound_sig) -> int.
bound_sig_size(bound_sig(_, _, Args, Ret, Loc)) ->
    1 + ty_exprs_size(Args) + ty_expr_size(Ret) + loc_size(Loc).

:- function fun_eqs_size(list(fun_eq)) -> int.
fun_eqs_size([]) -> 0.
fun_eqs_size([E|Es]) -> fun_eq_size(E) + fun_eqs_size(Es).

:- function fun_eq_size(fun_eq) -> int.
fun_eq_size(fun_eq(Params, Guards, Prelude, Rhs)) ->
    1 + head_args_size(Params) + guards_size(Guards)
      + fun_stmts_size(Prelude) + expr_size(Rhs).

% --- Declarations ---------------------------------------------------

:- function con_types_size(list(pair(con_key, list(ty_expr)))) -> int.
con_types_size([]) -> 0.
con_types_size([kv(K, Ts)|Rest]) ->
    con_key_size(K) + ty_exprs_size(Ts) + con_types_size(Rest).

:- function con_bounds_size(list(pair(con_key, list(bound_sig)))) -> int.
con_bounds_size([]) -> 0.
con_bounds_size([kv(K, Bs)|Rest]) ->
    con_key_size(K) + bound_sigs_size(Bs) + con_bounds_size(Rest).

:- function con_key_size(con_key) -> int.
con_key_size(con_key(_, _)) -> 1.

:- function type_defs_size(list(type_def)) -> int.
type_defs_size([]) -> 0.
type_defs_size([T|Ts]) -> type_def_size(T) + type_defs_size(Ts).

:- function type_def_size(type_def) -> int.
type_def_size(type_def(_, Vars, Kind, Loc)) ->
    1 + tvar_names_size(Vars) + type_kind_size(Kind) + loc_size(Loc).

:- function type_kind_size(type_kind) -> int.
type_kind_size(algebraic(Cons)) -> 1 + data_cons_size(Cons).
type_kind_size(opaque) -> 1.

:- function data_cons_size(list(data_con)) -> int.
data_cons_size([]) -> 0.
data_cons_size([C|Cs]) -> data_con_size(C) + data_cons_size(Cs).

:- function data_con_size(data_con) -> int.
data_con_size(data_con(_, Args)) -> 1 + ty_exprs_size(Args).

:- function ty_exprs_size(list(ty_expr)) -> int.
ty_exprs_size([]) -> 0.
ty_exprs_size([T|Ts]) -> ty_expr_size(T) + ty_exprs_size(Ts).

:- function ty_expr_size(ty_expr) -> int.
% `tvar` is the encoder's other string-valued leaf, reached from a
% different call site than a declaration's parameter list; it gets the
% same check.
ty_expr_size(tvar(V)) -> string_length(V).
ty_expr_size(tconx(_, Args)) -> 1 + ty_exprs_size(Args).
ty_expr_size(tfunx(Args, Ret)) -> 1 + ty_exprs_size(Args) + ty_expr_size(Ret).

% Type-parameter names are the one leaf the encoding spells as a
% *string* rather than as an atom (`sort_unique_tvars` orders them, and
% atoms have no ordering). `string_length` is what makes that a checked
% claim: it raises on anything else. Nothing else would notice the
% drift — `<` on two atoms only raises for a declaration with two
% distinct parameters, and the driver reads a name back only in an
% unbound-type-var diagnostic. The count it contributes is a length
% rather than a node count, which is fine: the total is discarded.
:- function tvar_names_size(list(string)) -> int.
tvar_names_size([]) -> 0.
tvar_names_size([V|Ns]) -> string_length(V) + tvar_names_size(Ns).

:- function loc_size(loc) -> int.
loc_size(loc(_, _, _)) -> 1.

% Not part of the AST, but built by the driver on the same
% spell-the-mangled-name-by-hand basis (`V2.labelValue`), so it gets
% the same treatment.
:- function diag_label_size(diag_label) -> int.
diag_label_size(label_rule(_)) -> 1.
diag_label_size(label_function(_)) -> 1.
diag_label_size(label_text(_)) -> 1.
diag_label_size(label_none) -> 1.
