% Entry points of the CHR type-checker (typechecker2).
%
% The Haskell driver (`src/YCHR/Internal/TypeCheck.hs`) encodes a
% desugared program as one ground term and tells exactly one of these
% constraints; everything the checker does happens in CHR from there,
% and the driver only decodes the two diagnostic lists that come back.
%
% `check_program` reports the declaration-level diagnostics and checks
% the program's rules and function equations; `check_goals` checks a
% query's goals against an already-checked program's declarations.
:- module('$tc2_main', [
    check_program/3,
    check_goals/6
]).

:- use_module('$tc2_ast').
:- use_module('$tc2_diag').
:- use_module('$tc2_env').
:- use_module('$tc2_pure').
:- use_module('$tc2_solver').
:- use_module('$tc2_walk').
:- use_module(library(lists)).

% `check_program(Program, Errors, Warnings)`: check a whole desugared
% program. `Errors` and `Warnings` are unbound on entry and are bound
% to the diagnostic lists once the program has been checked.
%
% `check_goals(Program, Goals, Loc, Label, Errors, Warnings)`: check a
% query's body goals against the declarations of an already-compiled
% program. `Program` is the same encoded program term; its rules and
% functions are ignored, only its declarations are in scope. The goals
% share one variable scope, but each is its own checking unit.
:- chr_constraint
    check_program(program, list(error), list(warning)),
    check_goals(program, list(body_goal), loc, diag_label, list(error), list(warning)).

% The declaration checks come first and the session's diagnostics
% second, which is the order a caller renders them in. Within each of
% the two it is whatever the checks happen to produce, and nothing pins
% it. Suppression sees both lists, because a unit whose only error is a
% constructor-arity mismatch still omits its warnings.
%
% `rigid_supply(-1)` seeds the solver's own down-counting gensym for
% the fresh parameters of a parametric evidence pin; the walker seeds
% its up-counting declaration-site supply itself.
check_program(Program, Errors, Warnings) <=>
    errors([]),
    warnings([]),
    rigid_supply(-1),
    Env is build_tc_env(Program),
    tell_decls(Env, Program, Facts),
    walk_program(Env, Program, Facts),
    collect(SolverErrors),
    collect_warnings(SolverWarnings),
    AllErrors is append(program_errors(env_cons(Env), Program), SolverErrors),
    Errors = AllErrors,
    Warnings is suppress_warnings(AllErrors, SolverWarnings).

% Goals are checked against the program's declarations only: they
% introduce no type definitions and no constructors, so none of the
% whole-program checks in `program_errors` applies. What does apply is
% the constructor-arity walk — a goal may *use* a known constructor at
% the wrong arity — and that runs per goal, in the goal's own unit.
check_goals(Program, Goals, Loc, Label, Errors, Warnings) <=>
    errors([]),
    warnings([]),
    rigid_supply(-1),
    Env is build_tc_env(Program),
    tell_decls(Env, Program, _Facts),
    walk_goals(Env, Goals, Loc, Label),
    collect(SolverErrors),
    collect_warnings(SolverWarnings),
    AllErrors is append(goals_arity_errors(env_cons(Env), Goals, Label, Loc),
                        SolverErrors),
    Errors = AllErrors,
    Warnings is suppress_warnings(AllErrors, SolverWarnings).
