% Declaration environment derived from an encoded program.
%
% The old checker builds three Haskell maps before it checks anything —
% `conMap` and `conAlias` (`src/YCHR/Internal/Constructors.hs`) and the
% `(name, arity)`-keyed type map of `validateTypeDefinitions` — and
% every lookup below is the CHR counterpart of one of them. The
% representation is an assoc list rather than a map: lookups are linear,
% which is irrelevant at the scale of one program's declarations, and it
% keeps the whole environment an ordinary value that pure functions can
% take and return.
%
% Two Haskell details this file has to reproduce exactly, because the
% differential harness compares diagnostics:
%
%   * `conMap` is a `Map.fromList`, so a constructor declared twice is
%     the *last* declaration — hence `lookup_con` returns the last
%     match, not the first;
%   * `conAlias` keeps a bare name only when exactly one declared
%     constructor *occurrence* uses it, so two declarations of the same
%     qualified name drop the alias rather than agreeing on it.
:- module('$tc2_env', [
    type(con_info/0),
    type(con_env/0),
    type(amb_key/0),
    type(tc_env/0),
    fun build_con_env/1,
    fun build_tc_env/1,
    fun env_cons/1,
    fun env_constraint_types/2,
    fun env_constraint_bounds/2,
    fun env_function_bounds/2,
    fun env_function_sigs/2,
    fun lookup_con/2,
    fun canonicalize_con/2,
    fun known_con_with_arity/3,
    fun parent_type_arity/2,
    fun con_name/1,
    fun con_args/1,
    fun con_arity/1,
    fun type_cons/1,
    fun type_def_name/1,
    fun type_def_vars/1,
    fun type_def_arity/1,
    fun type_def_loc/1,
    fun has_type_def/3,
    fun base_name_arities/2
]).

:- use_module('$tc2_ast').
:- use_module(library(lists)).
:- use_module(library(maybe)).
:- use_module(library(meta)).
:- use_module(library(pairs)).

% A data constructor together with the type declaration that introduced
% it. Mirrors the `(TypeDefinition, DataConstructor)` value of Haskell's
% `conMap`.
:- chr_type con_info ---> con_info(type_def, data_con).

% The constructor environment: every declared constructor keyed by its
% (mangled) name, and the bare-name aliases that resolve an unqualified
% use site.
:- chr_type con_env ---> con_env(list(pair(any, con_info)), list(pair(any, any))).

:- function build_con_env(list(type_def)) -> con_env.
build_con_env(Tds) -> con_env_from(con_entries(Tds)).

:- function con_env_from(list(pair(any, con_info))) -> con_env.
con_env_from(Entries) -> con_env(Entries, build_con_alias(Entries)).

% --- Constructor entries --------------------------------------------

:- function con_entries(list(type_def)) -> list(pair(any, con_info)).
con_entries([]) -> [].
con_entries([Td|Tds]) -> append(td_entries(Td, type_cons(Td)), con_entries(Tds)).

:- function td_entries(type_def, list(data_con)) -> list(pair(any, con_info)).
td_entries(_, []) -> [].
td_entries(Td, [Dc|Dcs]) -> [kv(con_name(Dc), con_info(Td, Dc)) | td_entries(Td, Dcs)].

% --- The bare-name alias table --------------------------------------

% A bare name resolves to a declaration only when exactly one declared
% constructor carries it; an ambiguous name is dropped so that the use
% site is treated as unknown rather than guessed at. `count_base`
% counts *occurrences*, matching `buildConAlias`'s `single [n]`: a name
% declared twice is ambiguous with itself and loses its alias too.
% (Faithful to the Haskell, but note that no corpus program tells the
% two readings apart: an ambiguous *bare* use site is already rejected
% by the renamer, so nothing reaches a wrongly-kept alias.)
%
% The base of each name is computed once, up front: `name_base` is a
% host call, and pairing it with its name here keeps the quadratic
% scan below to plain atom comparisons.
:- function build_con_alias(list(pair(any, con_info))) -> list(pair(any, any)).
build_con_alias(Entries) -> unique_bases_of(based_names(Entries)).

% The list has to be passed to itself, and there is no `let`, so the
% hoist is a helper's parameter — writing `based_names` twice would
% compute it, and its host calls, twice.
:- function unique_bases_of(list(pair(any, any))) -> list(pair(any, any)).
unique_bases_of(Based) -> unique_bases(Based, Based).

% Each constructor name paired with its own base, `kv(Base, Name)`.
:- function based_names(list(pair(any, con_info))) -> list(pair(any, any)).
based_names([]) -> [].
based_names([kv(N, _)|Rest]) -> [kv(name_base(N), N)|based_names(Rest)].

:- function unique_bases(list(pair(any, any)), list(pair(any, any)))
    -> list(pair(any, any)).
unique_bases([], _) -> [].
unique_bases([kv(B, N)|Ns], All) | count_base(B, All) == 1 ->
    [kv(B, N) | unique_bases(Ns, All)].
unique_bases([_|Ns], All) -> unique_bases(Ns, All).

:- function count_base(any, list(pair(any, any))) -> int.
count_base(_, []) -> 0.
count_base(B, [kv(B2, _)|Ns]) | B2 == B -> 1 + count_base(B, Ns).
count_base(B, [_|Ns]) -> count_base(B, Ns).

% --- Lookups --------------------------------------------------------

% A name that carries a module qualifier already names its declaration;
% only a bare one goes through the alias table. A mangled name is
% qualified exactly when its base differs from the whole, since the
% module part of `m__n` is never empty and `n` can never contain `__`.
:- function canonicalize_con(con_env, any) -> any.
canonicalize_con(con_env(_, _), N) | not(name_base(N) == N) -> N.
canonicalize_con(con_env(_, Alias), N) -> from_maybe(N, assoc_get(N, Alias)).

% The *last* matching entry, mirroring `Map.fromList`, whose later
% duplicate wins. Only reachable for a program that also reports a
% duplicate-constructor error, but the two checkers have to agree on
% which declaration the arity check then reads.
:- function lookup_con(con_env, any) -> maybe(con_info).
lookup_con(con_env(Entries, _), N) -> lookup_last(N, Entries).

:- function lookup_last(any, list(pair(any, con_info))) -> maybe(con_info).
lookup_last(_, []) -> nothing.
lookup_last(K, [kv(K2, V)|Rest]) | K2 == K -> prefer_later(lookup_last(K, Rest), V).
lookup_last(K, [_|Rest]) -> lookup_last(K, Rest).

:- function prefer_later(maybe(con_info), con_info) -> maybe(con_info).
prefer_later(nothing, V) -> just(V).
prefer_later(just(W), _) -> just(W).

% --- Accessors ------------------------------------------------------

:- function con_name(data_con) -> any.
con_name(data_con(N, _)) -> N.

:- function con_args(data_con) -> list(ty_expr).
con_args(data_con(_, Args)) -> Args.

:- function con_arity(con_info) -> int.
con_arity(con_info(_, Dc)) -> length(con_args(Dc)).

:- function type_cons(type_def) -> list(data_con).
type_cons(type_def(_, _, algebraic(Cs), _)) -> Cs.
type_cons(type_def(_, _, opaque, _)) -> [].

:- function type_def_name(type_def) -> any.
type_def_name(type_def(N, _, _, _)) -> N.

:- function type_def_vars(type_def) -> list(string).
type_def_vars(type_def(_, Vars, _, _)) -> Vars.

:- function type_def_arity(type_def) -> int.
type_def_arity(Td) -> length(type_def_vars(Td)).

:- function type_def_loc(type_def) -> loc.
type_def_loc(type_def(_, _, _, L)) -> L.

% --- Use-site lookups over the constructor environment ---------------

% True when `Name` is a known data constructor declared at exactly
% `UseArity`. Ports `knownConstructorWithArity`: a wrong-arity use is
% diagnosed by the arity walk of `tc2_pure.chr`, and gating the
% `check_constructor_use` emission on this is what keeps a second,
% spurious inconsistency off the same site.
:- function known_con_with_arity(con_env, any, int) -> bool.
known_con_with_arity(Env, Name, UseArity) ->
    con_arity_matches(UseArity, lookup_con(Env, Name)).

:- function con_arity_matches(int, maybe(con_info)) -> bool.
con_arity_matches(_, nothing) -> false.
con_arity_matches(UseArity, just(Info)) -> con_arity(Info) == UseArity.

% Number of type parameters of the type a data constructor belongs to.
% Zero for an unknown constructor, whose callers gate on
% `known_con_with_arity` anyway. Ports `parentTypeArity`.
:- function parent_type_arity(con_env, any) -> int.
parent_type_arity(Env, Name) -> con_info_parent_arity(lookup_con(Env, Name)).

:- function con_info_parent_arity(maybe(con_info)) -> int.
con_info_parent_arity(nothing) -> 0.
con_info_parent_arity(just(con_info(Td, _))) -> type_def_arity(Td).

% --- The whole checking environment ---------------------------------
%
% Ports `TypeCheckEnv` (TypeCheck.hs). Everything in it is derived from
% the encoded program and immutable for the whole check, so it is built
% once and passed down.

% Key of the ambient-signature and function-bounds tables: functions are
% arity-overloadable, so a bound naming `g/1` must not capture calls to
% `g/2`. Ports `AmbientKey`.
:- chr_type amb_key ---> amb_key(any, int).

% The constructor environment, the declared argument types and bounds of
% every constraint, the bounds of every bounded function, and the
% declared signatures of every function.
%
% The last two mirror `functionBoundsEnv` and `functionSigsEnv`: bounds
% are keyed by name *and* arity, while signatures are keyed by name
% alone with every arity mixed together — which is what the CHR side's
% `function_sig` / `function_sigs` facts see, and what a bound's
% candidate list is assembled from.
:- chr_type tc_env ---> tc_env(con_env,
                               list(pair(con_key, list(ty_expr))),
                               list(pair(con_key, list(bound_sig))),
                               list(pair(amb_key, list(bound_sig))),
                               list(pair(any, list(fun_sig)))).

:- function build_tc_env(program) -> tc_env.
build_tc_env(program(_, Funs, ConTypes, ConBounds, Tds)) ->
    tc_env(build_con_env(Tds), ConTypes, ConBounds,
           function_bounds_env(Funs), function_sigs_env(Funs)).

:- function env_cons(tc_env) -> con_env.
env_cons(tc_env(Cons, _, _, _, _)) -> Cons.

% The declared argument types of a constraint, or `[]` for one with no
% declaration. Mirrors `Map.findWithDefault []`.
:- function env_constraint_types(tc_env, con_key) -> list(ty_expr).
env_constraint_types(tc_env(_, Types, _, _, _), Key) ->
    from_maybe([], assoc_get(Key, Types)).

:- function env_constraint_bounds(tc_env, con_key) -> list(bound_sig).
env_constraint_bounds(tc_env(_, _, Bounds, _, _), Key) ->
    from_maybe([], assoc_get(Key, Bounds)).

:- function env_function_bounds(tc_env, amb_key) -> list(bound_sig).
env_function_bounds(tc_env(_, _, _, Bounds, _), Key) ->
    from_maybe([], assoc_get(Key, Bounds)).

:- function env_function_sigs(tc_env, any) -> list(fun_sig).
env_function_sigs(tc_env(_, _, _, _, Sigs), Name) ->
    from_maybe([], assoc_get(Name, Sigs)).

% Only bounded functions have an entry, matching the Haskell's
% `not (null f.requiring)` filter. The lookup is first-wins where
% `Map.fromList` is last-wins; the two can only differ if one
% `(name, arity)` were declared twice, which `Resolve` groups away
% before the checker sees it.
:- function function_bounds_env(list(fun_def)) -> list(pair(amb_key, list(bound_sig))).
function_bounds_env([]) -> [].
function_bounds_env([fun_def(_, _, _, [], _)|Fs]) -> function_bounds_env(Fs).
function_bounds_env([fun_def(N, A, _, Bs, _)|Fs]) ->
    [kv(amb_key(N, A), Bs) | function_bounds_env(Fs)].

% Every function's *effective* signatures, keyed by name with the
% arities mixed. An untyped function contributes the all-`any`
% signature it is checked as (spec §Defaults). Entries for one name
% accumulate in program order, as `Map.fromListWith (flip (++))` does.
:- function function_sigs_env(list(fun_def)) -> list(pair(any, list(fun_sig))).
function_sigs_env(Fs) -> function_sigs_acc(Fs, []).

:- function function_sigs_acc(list(fun_def), list(pair(any, list(fun_sig))))
    -> list(pair(any, list(fun_sig))).
function_sigs_acc([], Acc) -> Acc.
function_sigs_acc([F|Fs], Acc) ->
    function_sigs_acc(Fs, push_sigs(fun_def_name(F), effective_sigs(F), Acc)).

:- function push_sigs(any, list(fun_sig), list(pair(any, list(fun_sig))))
    -> list(pair(any, list(fun_sig))).
push_sigs(N, Sigs, []) -> [kv(N, Sigs)].
push_sigs(N, Sigs, [kv(K, Old)|Rest]) | K == N -> [kv(K, append(Old, Sigs))|Rest].
push_sigs(N, Sigs, [P|Rest]) -> [P|push_sigs(N, Sigs, Rest)].

:- function fun_def_name(fun_def) -> any.
fun_def_name(fun_def(N, _, _, _, _)) -> N.

:- function effective_sigs(fun_def) -> list(fun_sig).
effective_sigs(fun_def(_, A, [], _, _)) -> [all_any_sig(A)].
effective_sigs(fun_def(_, _, Sigs, _, _)) -> Sigs.

% The signature an untyped declaration is checked as: every argument
% and the result `any`, spelled as the encoder spells the `any` type.
:- function all_any_sig(int) -> fun_sig.
all_any_sig(A) -> fun_sig(any_types(A), tconx(quote(any), [])).

:- function any_types(int) -> list(ty_expr).
any_types(N) | N =< 0 -> [].
any_types(N) -> [tconx(quote(any), []) | any_types(N - 1)].

% --- The (name, arity)-keyed type table -----------------------------

% `Map.member (name, arity)` over the validation map. The map's values
% are never read, so a scan of the declarations is exactly equivalent
% and there is nothing to build.
:- function has_type_def(any, int, list(type_def)) -> bool.
has_type_def(_, _, []) -> false.
has_type_def(N, A, [Td|_]) | type_def_name(Td) == N, type_def_arity(Td) == A -> true.
has_type_def(N, A, [_|Tds]) -> has_type_def(N, A, Tds).

% The distinct arities of every declaration whose *base* name matches,
% which is how a reference that missed the table at its own arity is
% told apart from one that names nothing at all. Only the singleton
% case is acted on, so the order of the distinct arities does not
% matter (Haskell's `List.nub` keeps first occurrences; this keeps
% last).
:- function base_name_arities(any, list(type_def)) -> list(int).
base_name_arities(_, []) -> [].
base_name_arities(B, [Td|Tds]) | name_base(type_def_name(Td)) == B ->
    add_new(type_def_arity(Td), base_name_arities(B, Tds)).
base_name_arities(B, [_|Tds]) -> base_name_arities(B, Tds).

:- function add_new(int, list(int)) -> list(int).
add_new(A, As) | member(A, As) -> As.
add_new(A, As) -> [A|As].
